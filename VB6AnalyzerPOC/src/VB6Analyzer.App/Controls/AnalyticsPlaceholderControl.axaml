<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Macondo.App.Controls.AnalyticsPlaceholderControl">

    <Grid Background="#DC14141C"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="28,24"
                MaxWidth="480"
                BoxShadow="0 8 24 0 #60000000">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
                <!-- Icona in cerchio con accento -->
                <Border Width="48"
                        Height="48"
                        CornerRadius="24"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource ThemeBackgroundElevatedBrush}"
                        BorderBrush="{DynamicResource ThemeAccentBrush}"
                        BorderThickness="1.5">
                    <PathIcon Data="{StaticResource IconZap}"
                              Width="20"
                              Height="20"
                              Foreground="{DynamicResource ThemeAccentBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>

                <!-- Titolo -->
                <TextBlock x:Name="TitleText"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />

                <!-- Descrizione -->
                <TextBlock x:Name="DescText"
                           FontSize="12"
                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           MaxWidth="420" />

                <!-- Pannello Azioni (Avvia Analisi / Avvia Tutte) -->
                <StackPanel x:Name="CardActionPanel"
                            Orientation="Horizontal"
                            Spacing="10"
                            HorizontalAlignment="Center"
                            Margin="0,6,0,0">
                    <!-- Pulsante Primario "Avvia Analisi" -->
                    <Button x:Name="StartButton"
                            Padding="16,8"
                            CornerRadius="6"
                            Cursor="Hand"
                            Background="{DynamicResource ThemeAccentBrush}"
                            Foreground="#FFFFFF"
                            FontWeight="SemiBold"
                            FontSize="12"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconPlay}"
                                      Width="12"
                                      Height="12"
                                      Foreground="#FFFFFF"
                                      VerticalAlignment="Center" />
                            <TextBlock x:Name="StartBtnText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Pulsante Secondario "Avvia Tutte le Analisi" -->
                    <Button x:Name="StartAllButton"
                            Padding="14,8"
                            CornerRadius="6"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                            BorderThickness="1"
                            Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                            FontSize="11">
                        <TextBlock x:Name="StartAllBtnText" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>

                <!-- Pannello di elaborazione (in corso) -->
                <StackPanel x:Name="ComputingContainer"
                            Spacing="10"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0"
                            IsVisible="False">
                    <ProgressBar x:Name="ComputeProgressBar"
                                 Width="220"
                                 Height="4"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource ThemeAccentBrush}"
                                 HorizontalAlignment="Center" />
                    <TextBlock x:Name="ComputingText"
                               FontSize="12"
                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
