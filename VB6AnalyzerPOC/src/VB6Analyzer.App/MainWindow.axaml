<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Macondo.App.Controls"
        xmlns:models="using:Macondo.App.Models"
        xmlns:services="using:Macondo.App.Services"
        xmlns:views="using:Macondo.App.Views"
        x:Class="Macondo.App.MainWindow"
        Title="Macondo"
        Icon="avares://Macondo/Assets/Icons/icon1_star_knot.ico"
        Width="1400" Height="900"
        Background="{DynamicResource ThemeBackgroundPrimaryBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        DragDrop.AllowDrop="True">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="{Binding $parent[Window].OffScreenMargin}">

        <!-- Barra Superiore Stile IDE (Brand & Menu a Sinistra | Area Trascinamento al Centro | Controlli Finestra a Destra) -->
        <Border x:Name="TopBarBorder" Grid.Row="0"
                Background="{DynamicResource ThemeBackgroundSecondaryBrush}"
                BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                BorderThickness="0,0,0,1" Padding="8,0,0,0" Height="34">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Sinistra: Brand / Logo App + Menu a Discesa -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,16,0" Spacing="6">
                        <Image Source="avares://Macondo/Assets/Icons/icon1_star_knot_512.png" Width="16" Height="16" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <TextBlock x:Name="BrandTitleText" Text="Macondo" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Menu Background="Transparent">
                        <MenuItem x:Name="FileMenu" Header="_File">
                            <MenuItem x:Name="OpenSubMenu" Header="Apri">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" Foreground="#D4A72C" />
                                </MenuItem.Icon>
                                <MenuItem x:Name="OpenProjectFilesMenuItem" Header="Progetto / Gruppo..." InputGesture="Ctrl+Shift+O">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource IconFile}" Width="14" Height="14" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="OpenFolderMenuItem" Header="Cartella..." InputGesture="Ctrl+Shift+Alt+O">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" Foreground="#D4A72C" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem x:Name="RecentProjectsMenuItem" Header="Recenti">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconHistory}" Width="14" Height="14" Foreground="#A78BFA" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="RefreshProjectMenuItem" Header="Ricarica Progetto Corrente" InputGesture="Ctrl+R">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14" Foreground="#4AE8D0" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="LoadFixturesMenuItem" Header="Carica Fixtures Test" IsVisible="False">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconBeaker}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="GenerateFakeMenuItem" Header="Grafo Demo (~500 nodi)" IsVisible="False">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconZap}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="ExportMarkdownMenuItem" Header="Esporta Repo Map (Markdown)...">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconMarkdown}" Width="14" Height="14" Foreground="#4AE8D0" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ExportJsonMenuItem" Header="Esporta Grafo (JSON)...">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconExport}" Width="14" Height="14" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ImportJsonMenuItem" Header="Importa Grafo (JSON)...">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconImport}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ExportSliceMenuItem" Header="Esporta Context Slice LLM...">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconCopy}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="SettingsMenuItem" Header="Impostazioni..." InputGesture="Ctrl+,">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconSettings}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="ExitMenuItem" Header="Esci" InputGesture="Alt+F4">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconExit}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem x:Name="ViewMenu" Header="_Visualizza">
                            <MenuItem x:Name="ToggleExplorerMenuItem" Header="Mostra/Nascondi Project Explorer" InputGesture="Ctrl+B">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconPanelLeft}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ToggleInspectorMenuItem" Header="Mostra/Nascondi Symbol Inspector" InputGesture="Ctrl+I">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconPanelRight}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="ResetViewMenuItem" Header="Reset Vista">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconTarget}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ExpandAllMenuItem" Header="Espandi Tutto">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconExpandAll}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="CollapseAllMenuItem" Header="Comprimi Tutto">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconCollapseAll}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="FilterDetailLevelMenuItem" Header="Filtro Livelli Simboli">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconFilter}" Width="14" Height="14" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                                <MenuItem x:Name="FilterAllMenuItem" Header="Completo (Tutti i Membri)" />
                                <MenuItem x:Name="FilterMethodsPropsMenuItem" Header="Metodi &amp; Proprietà" />
                                <MenuItem x:Name="FilterContainersOnlyMenuItem" Header="Solo Contenitori (Moduli)" />
                                <Separator />
                                <MenuItem x:Name="FilterMethodsMenuItem" Header="Mostra Metodi (Sub / Function)" />
                                <MenuItem x:Name="FilterPropertiesMenuItem" Header="Mostra Proprietà" />
                                <MenuItem x:Name="FilterFieldsMenuItem" Header="Mostra Campi e Variabili" />
                                <MenuItem x:Name="FilterConstantsMenuItem" Header="Mostra Costanti" />
                                <MenuItem x:Name="FilterTypesMenuItem" Header="Mostra Tipi ed Enumerazioni" />
                            </MenuItem>
                            <MenuItem x:Name="FilterProjectsMenuItem" Header="Filtra Progetti" IsVisible="False">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconProject}" Width="14" Height="14" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="GraphLayoutMenuItem" Header="Disposizione Grafo">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconGraph}" Width="14" Height="14" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                                <MenuItem x:Name="LayoutStandardMenuItem" Header="Radiale Standard" />
                                <MenuItem x:Name="LayoutAffinityMenuItem" Header="Radiale per Affinità" />
                                <MenuItem x:Name="LayoutIslandsMenuItem" Header="Cluster a Isole (Sottosistemi)" />
                                <MenuItem x:Name="LayoutForceMenuItem" Header="Force-Directed (Fisica a Molle)" />
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="ToggleHoverSelectionMenuItem" Header="Selezione al Passaggio del Mouse" Click="OnToggleHoverSelectionClicked">
                                <MenuItem.Icon>
                                    <PathIcon x:Name="HoverSelectionCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ToggleTabLabelsMenuItem" Header="Mostra etichette schede" Click="OnToggleTabLabelsClicked">
                                <MenuItem.Icon>
                                    <PathIcon x:Name="TabLabelsCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <!-- Sottomenu Schede Analitiche Visibili -->
                            <MenuItem x:Name="VisibleTabsMenuItem" Header="Schede Analitiche Visibili">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconTable}" Width="14" Height="14" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                                <MenuItem x:Name="ToggleTabGraphMenuItem" Header="Vista Grafo" Click="OnToggleTabGraphMenuClicked">
                                    <MenuItem.Icon>
                                        <PathIcon x:Name="TabGraphCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ToggleTabDsmMenuItem" Header="Matrice DSM" Click="OnToggleTabDsmMenuClicked">
                                    <MenuItem.Icon>
                                        <PathIcon x:Name="TabDsmCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ToggleTabTreemapMenuItem" Header="Treemap Metriche" Click="OnToggleTabTreemapMenuClicked">
                                    <MenuItem.Icon>
                                        <PathIcon x:Name="TabTreemapCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ToggleTabHotspotMenuItem" Header="Hotspot di Rischio" Click="OnToggleTabHotspotMenuClicked">
                                    <MenuItem.Icon>
                                        <PathIcon x:Name="TabHotspotCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ToggleTabScreenFlowMenuItem" Header="Flusso Schermate" Click="OnToggleTabScreenFlowMenuClicked">
                                    <MenuItem.Icon>
                                        <PathIcon x:Name="TabScreenFlowCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ToggleTabControlFlowMenuItem" Header="Control Flow (CFG)" Click="OnToggleTabControlFlowMenuClicked">
                                    <MenuItem.Icon>
                                        <PathIcon x:Name="TabControlFlowCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ToggleTabMartinMenuItem" Header="Metriche Martin" Click="OnToggleTabMartinMenuClicked">
                                    <MenuItem.Icon>
                                        <PathIcon x:Name="TabMartinCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ToggleTabDeadCodeMenuItem" Header="Dead Code &amp; Orfani" Click="OnToggleTabDeadCodeMenuClicked">
                                    <MenuItem.Icon>
                                        <PathIcon x:Name="TabDeadCodeCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ToggleTabSharedStateMenuItem" Header="Stato Condiviso" Click="OnToggleTabSharedStateMenuClicked">
                                    <MenuItem.Icon>
                                        <PathIcon x:Name="TabSharedStateCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ToggleTabTemporalCouplingMenuItem" Header="Temporal Coupling" Click="OnToggleTabTemporalCouplingMenuClicked">
                                    <MenuItem.Icon>
                                        <PathIcon x:Name="TabTemporalCouplingCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ToggleTabArchitecturalFlowMenuItem" Header="Flussi Architetturali" Click="OnToggleTabArchitecturalFlowMenuClicked">
                                    <MenuItem.Icon>
                                        <PathIcon x:Name="TabArchitecturalFlowCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ToggleTabCodeCityMenuItem" Header="CodeCity 3D" Click="OnToggleTabCodeCityMenuClicked">
                                    <MenuItem.Icon>
                                        <PathIcon x:Name="TabCodeCityCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ToggleTabBlastRadiusGridMenuItem" Header="Griglia Blast Radius" Click="OnToggleTabBlastRadiusGridMenuClicked">
                                    <MenuItem.Icon>
                                        <PathIcon x:Name="TabBlastRadiusGridCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem x:Name="ToggleTabCohesionMenuItem" Header="Coesione &amp; LCOM" Click="OnToggleTabCohesionMenuClicked">
                                    <MenuItem.Icon>
                                        <PathIcon x:Name="TabCohesionCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ToggleTabMaintainabilityMenuItem" Header="Manutenibilità" Click="OnToggleTabMaintainabilityMenuClicked">
                                    <MenuItem.Icon>
                                        <PathIcon x:Name="TabMaintainabilityCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ToggleTabArchitecturalRulesMenuItem" Header="Regole Architettura" Click="OnToggleTabArchitecturalRulesMenuClicked">
                                    <MenuItem.Icon>
                                        <PathIcon x:Name="TabArchitecturalRulesCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ToggleTabCodeCloneMenuItem" Header="Duplicazioni (CPD)" Click="OnToggleTabCodeCloneMenuClicked">
                                    <MenuItem.Icon>
                                        <PathIcon x:Name="TabCodeCloneCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ToggleTabSocialCodeMenuItem" Header="Social &amp; Bus Factor" Click="OnToggleTabSocialCodeMenuClicked">
                                    <MenuItem.Icon>
                                        <PathIcon x:Name="TabSocialCodeCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ToggleTabDataFlowMenuItem" Header="Data Flow &amp; Taint" Click="OnToggleTabDataFlowMenuClicked">
                                    <MenuItem.Icon>
                                        <PathIcon x:Name="TabDataFlowCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ToggleTabApiDiffMenuItem" Header="API Diff &amp; SemVer" Click="OnToggleTabApiDiffMenuClicked">
                                    <MenuItem.Icon>
                                        <PathIcon x:Name="TabApiDiffCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ToggleTabCrudMatrixMenuItem" Header="Matrice CRUD" Click="OnToggleTabCrudMatrixMenuClicked">
                                    <MenuItem.Icon>
                                        <PathIcon x:Name="TabCrudMatrixCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem x:Name="AnalysisMenu" Header="_Analisi">
                            <MenuItem x:Name="BlastRadiusMenuItem" Header="Calcola Blast Radius" InputGesture="F5">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconBlastRadius}" Width="14" Height="14" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ShowCallersMenuItem" Header="Mostra Callers">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconCallers}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ShowCalleesMenuItem" Header="Mostra Callees">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconCallees}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ClearHighlightMenuItem" Header="Rimuovi Evidenziazione">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconClose}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="RunAllAnalyticsMenuItem" Header="Avvia Tutte le Analisi" Click="OnRunAllAnalyticsMenuClicked">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconPlay}" Width="14" Height="14" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ToggleBackgroundAnalyticsMenuItem" Header="Pre-elaborazione automatica in background" Click="OnToggleBackgroundAnalyticsMenuClicked">
                                <MenuItem.Icon>
                                    <PathIcon x:Name="BackgroundAnalyticsCheckIcon" Data="{StaticResource IconCheck}" Width="14" Height="14" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem x:Name="HelpMenu" Header="_Aiuto">
                            <MenuItem x:Name="InfoMenuItem" Header="Guida &amp; Concetti..." InputGesture="F1">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconHelp}" Width="14" Height="14" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="CheckUpdatesMenuItem" Header="Verifica Aggiornamenti...">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconUpdate}" Width="14" Height="14" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="ResetSettingsMenuItem" Header="Ripristina Impostazioni Predefinite...">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ClearCacheMenuItem" Header="Pulisci Cache Progetti...">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14" Foreground="#FF5555" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <!-- Centro: Area di Trascinamento Finestra -->
                <Border Grid.Column="1" Background="Transparent"
                        PointerPressed="OnTitleBarPointerPressed"
                        DoubleTapped="OnTitleBarDoubleTapped" />

                <!-- Destra: Pulsanti di Controllo Finestra e Impostazioni -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <StackPanel.Styles>
                        <Style Selector="Button.caption-btn">
                            <Setter Property="Width" Value="46" />
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="CornerRadius" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
                        </Style>
                        <Style Selector="Button.caption-btn:pointerover">
                            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                        </Style>
                        <Style Selector="Button.caption-close:pointerover">
                            <Setter Property="Background" Value="#E81123" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Style>
                    </StackPanel.Styles>

                    <Button x:Name="SettingsButton" Classes="caption-btn" ToolTip.Tip="Impostazioni (Ctrl+,)">
                        <PathIcon Data="{StaticResource IconSettings}" Width="12" Height="12" />
                    </Button>
                    <Button x:Name="MinimizeButton" Classes="caption-btn" ToolTip.Tip="Riduci a icona">
                        <PathIcon Data="{StaticResource IconWindowMinimize}" Width="10" Height="10" />
                    </Button>
                    <Button x:Name="MaximizeButton" Classes="caption-btn" ToolTip.Tip="Ingrandisci / Ripristina">
                        <PathIcon x:Name="MaximizeIcon" Data="{StaticResource IconWindowMaximize}" Width="10" Height="10" />
                    </Button>
                    <Button x:Name="CloseButton" Classes="caption-btn caption-close" ToolTip.Tip="Chiudi">
                        <PathIcon Data="{StaticResource IconWindowClose}" Width="10" Height="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Nuova Riga Toolbar Dedicata: Toggle Explorer (Sinistra) | Barra Ricerca (Centro) | Toggle Inspector (Destra) -->
        <Border x:Name="SearchRowBorder" Grid.Row="1"
                Background="{DynamicResource ThemeBackgroundSecondaryBrush}"
                BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                BorderThickness="0,0,0,1" Height="36" Padding="8,0">
            <Border.Styles>
                <Style Selector="Button.toggle-panel-btn">
                    <Setter Property="Width" Value="30" />
                    <Setter Property="Height" Value="26" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="4" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style Selector="Button.toggle-panel-btn PathIcon">
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
                </Style>
                <Style Selector="Button.toggle-panel-btn:pointerover">
                    <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
                </Style>
                <Style Selector="Button.toggle-panel-btn:pointerover PathIcon">
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                </Style>
                <Style Selector="Button.toggle-panel-btn.active">
                    <Setter Property="Background" Value="{DynamicResource ThemeBackgroundSurfaceBrush}" />
                </Style>
                <Style Selector="Button.toggle-panel-btn.active PathIcon">
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                </Style>
            </Border.Styles>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Sinistra: Pulsante Mostra/Nascondi Project Explorer & Selettore VCS (Git / SVN) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="ToggleExplorerTopButton"
                            Classes="toggle-panel-btn"
                            ToolTip.Tip="Mostra/Nascondi Project Explorer (Ctrl+B)">
                        <PathIcon x:Name="ToggleExplorerTopIcon" Data="{StaticResource IconPanelLeft}" Width="14" Height="14" />
                    </Button>

                    <!-- VCS (Git & SVN) Branch Button & Popup -->
                    <Panel x:Name="GitBranchPanel" IsVisible="False" VerticalAlignment="Center">
                        <Button x:Name="GitBranchButton"
                                Height="26"
                                Padding="8,0"
                                Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                FontSize="11"
                                MaxWidth="190"
                                ToolTip.Tip="Branch VCS corrente. Clicca per cambiare branch.">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon x:Name="GitBranchIcon" Data="{StaticResource IconGitBranch}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="GitBranchText" Text="master" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                            </StackPanel>
                        </Button>

                        <!-- Popup Selezione e Switch Branch VCS (Git / SVN) -->
                        <Popup x:Name="GitBranchPopup"
                               PlacementTarget="{Binding ElementName=GitBranchButton}"
                               Placement="Bottom"
                               IsLightDismissEnabled="True"
                               VerticalOffset="4">
                            <Border Background="{DynamicResource ThemeBackgroundElevatedBrush}"
                                    BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    BoxShadow="0 8 24 0 #40000000"
                                    MinWidth="260"
                                    MaxWidth="360"
                                    MaxHeight="320"
                                    Padding="8">
                                <DockPanel>
                                    <TextBlock x:Name="GitBranchPopupTitle"
                                               DockPanel.Dock="Top"
                                               Text="Cambia Branch"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                               Margin="4,2,4,6" />
                                    <TextBox x:Name="GitBranchSearchBox"
                                             DockPanel.Dock="Top"
                                             Watermark="Cerca branch..."
                                             FontSize="11"
                                             Margin="0,0,0,6"
                                             TextChanged="OnGitBranchSearchTextChanged" />
                                    <ListBox x:Name="GitBranchListBox"
                                             Background="Transparent"
                                             SelectionMode="Single"
                                             SelectionChanged="OnGitBranchSelected">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="models:VcsBranchInfo">
                                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="2">
                                                    <PathIcon Grid.Column="0" Data="{StaticResource IconVcsBranch}" Width="11" Height="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" />
                                                    <PathIcon Grid.Column="2" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" IsVisible="{Binding IsCurrent}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Panel>
                </StackPanel>

                <!-- Centro: Casella di Ricerca Dedicata Centrata -->
                <Panel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Panel.Styles>
                        <Style Selector="TextBox#SearchBox">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundSurfaceBrush}" />
                            <Setter Property="CornerRadius" Value="4" />
                        </Style>
                        <Style Selector="TextBox#SearchBox:pointerover /template/ Border#PART_BorderElement">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
                        </Style>
                        <Style Selector="TextBox#SearchBox:focus /template/ Border#PART_BorderElement">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
                        </Style>
                    </Panel.Styles>
                    <TextBox x:Name="SearchBox"
                             Width="460"
                             Height="26"
                             MinHeight="26"
                             FontSize="11"
                             Padding="6,1"
                             BorderThickness="0"
                             BorderBrush="Transparent"
                             Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                             CornerRadius="4"
                             VerticalContentAlignment="Center"
                             Watermark="Cerca simbolo nel grafo..."
                             TextChanged="OnSearchTextChanged"
                             KeyDown="OnSearchBoxKeyDown">
                        <TextBox.InnerLeftContent>
                            <PathIcon Data="{StaticResource IconSearch}" Width="12" Height="12" VerticalAlignment="Center" Margin="6,0,4,0" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                        </TextBox.InnerLeftContent>
                        <TextBox.InnerRightContent>
                            <Border Background="{DynamicResource ThemeBackgroundElevatedBrush}"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="3"
                                    Padding="5,1"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Ctrl + F"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </Border>
                        </TextBox.InnerRightContent>
                    </TextBox>

                    <!-- Dropdown Risultati Multipli -->
                    <Popup x:Name="SearchResultsPopup"
                           PlacementTarget="{Binding ElementName=SearchBox}"
                           Placement="Bottom"
                           IsLightDismissEnabled="True"
                           VerticalOffset="4">
                        <Border Background="{DynamicResource ThemeBackgroundElevatedBrush}"
                                BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                BoxShadow="0 8 24 0 #40000000"
                                MinWidth="380"
                                MaxWidth="520"
                                MaxHeight="320"
                                Padding="6">
                            <DockPanel>
                                <TextBlock x:Name="SearchResultsHeader"
                                           DockPanel.Dock="Top"
                                           Text="Risultati trovati:"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                           Margin="6,4,6,6" />
                                <ListBox x:Name="SearchResultsList"
                                         Background="Transparent"
                                         SelectionChanged="OnSearchResultSelected"
                                         KeyDown="OnSearchResultsListKeyDown">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="models:SearchResultItem">
                                            <Grid ColumnDefinitions="Auto,*" Margin="2">
                                                <Border Grid.Column="0"
                                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="4,1"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{DynamicResource ThemeTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Popup>
                </Panel>

                <!-- Destra: Pulsante Mostra/Nascondi Symbol Inspector -->
                <Button Grid.Column="2" x:Name="ToggleInspectorTopButton"
                        Classes="toggle-panel-btn"
                        ToolTip.Tip="Mostra/Nascondi Symbol Inspector (Ctrl+I)">
                    <PathIcon x:Name="ToggleInspectorTopIcon" Data="{StaticResource IconPanelRight}" Width="14" Height="14" />
                </Button>
            </Grid>
        </Border>

        <!-- Area Centrale: Explorer | Graph + Floating Actions | Inspector -->
        <Grid x:Name="CentralGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180" MaxWidth="600" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="360" MinWidth="240" MaxWidth="800" />
            </Grid.ColumnDefinitions>

            <!-- Pannello Sinistro: Project Explorer -->
            <views:ProjectExplorerView x:Name="ProjectExplorerControl" Grid.Column="0"
                                       SelectionChanged="OnExplorerSelectionChanged"
                                       ItemDoubleTapped="OnExplorerItemDoubleTapped"
                                       OpenFileRequested="OnExplorerOpenFileRequested"
                                       OpenFolderRequested="OnExplorerOpenFolderRequested"
                                       CopyPathRequested="OnExplorerCopyPathRequested"
                                       ProjectVisibilityChanged="OnExplorerProjectVisibilityChanged"
                                       SelectAllProjectsRequested="OnExplorerSelectAllProjectsRequested" />

            <!-- Splitter Ridimensionamento Pannello Sinistro (Project Explorer) -->
            <GridSplitter x:Name="LeftGridSplitter" Grid.Column="1"
                          Width="4"
                          Background="{DynamicResource ThemeBorderDefaultBrush}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWestEast" />

            <!-- Contenitore Centrale: TabControl di Analisi oppure Schermata di Benvenuto -->
            <Panel Grid.Column="2">
                <!-- SCHERMATA DI BENVENUTO / EMPTY STATE -->
                <views:WelcomeView x:Name="WelcomeControl"
                                   IsVisible="True"
                                   OpenProjectRequested="OnWelcomeOpenProjectRequested"
                                   OpenFolderRequested="OnWelcomeOpenFolderRequested"
                                   LoadFixturesRequested="OnWelcomeLoadFixturesRequested"
                                   PendingAnalyzeRequested="OnWelcomePendingAnalyzeRequested"
                                   RecentItemClicked="OnWelcomeRecentItemClicked" />

                <!-- TAB CONTROL PRINCIPALE DI ANALISI -->
                <TabControl x:Name="CentralTabControl" SelectedIndex="0" Padding="0" IsVisible="False">
                    <TabControl.Resources>
                        <!-- Menu Contestuale Tasto Destro sulle Schede di Analisi -->
                        <ContextMenu x:Key="AnalyticsTabContextMenu">
                            <MenuItem x:Name="CtxTabHide" Header="Nascondi scheda" Click="OnTabContextMenuHideClicked">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconClearFilter}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="CtxTabShowAll" Header="Mostra tutte le schede" Click="OnTabContextMenuShowAllClicked">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="CtxTabManage" Header="Personalizza schede..." Click="OnTabContextMenuManageClicked">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconSettings}" Width="12" Height="12" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </TabControl.Resources>
                    <TabControl.Styles>
                    <Style Selector="TabItem">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="Padding" Value="14,6" />
                        <Setter Property="Margin" Value="2,2" />
                        <Setter Property="CornerRadius" Value="4" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
                        <Setter Property="MinHeight" Value="28" />
                    </Style>
                    <Style Selector="TabItem PathIcon">
                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
                    </Style>
                    <Style Selector="TabItem:pointerover">
                        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                    </Style>
                    <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
                        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
                    </Style>
                    <Style Selector="TabItem:pointerover PathIcon">
                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                    </Style>
                    <Style Selector="TabItem:selected">
                        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundSurfaceBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                    <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
                        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundSurfaceBrush}" />
                    </Style>
                    <Style Selector="TabItem:selected PathIcon">
                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                    </Style>
                    <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
                        <Setter Property="IsVisible" Value="False" />
                        <Setter Property="Height" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Opacity" Value="0" />
                    </Style>
                    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
                        <Setter Property="IsVisible" Value="False" />
                        <Setter Property="Height" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Opacity" Value="0" />
                    </Style>
                    <Style Selector="TabItem:pointerover /template/ Border#PART_SelectedPipe">
                        <Setter Property="IsVisible" Value="False" />
                        <Setter Property="Height" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Opacity" Value="0" />
                    </Style>
                    <Style Selector="TabItem:selected:pointerover /template/ Border#PART_SelectedPipe">
                        <Setter Property="IsVisible" Value="False" />
                        <Setter Property="Height" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Opacity" Value="0" />
                    </Style>
                </TabControl.Styles>

                <!-- TAB 1: Canvas Interattivo del Grafo con Floating HUD -->
                <TabItem x:Name="GraphTabItem" ToolTip.Tip="Vista Grafo Semantico">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconGraph}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="GraphTabHeader" Text="Vista Grafo" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid x:Name="GraphContainerGrid">
                        <Grid.Resources>
                            <!-- Menu Contestuale Tasto Destro sui Nodi del Grafo -->
                            <ContextMenu x:Key="GraphNodeContextMenu">
                                <MenuItem x:Name="CtxNodeExportMarkdown" Header="Esporta MD" Click="OnNodeExportMarkdownClicked">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource IconMarkdown}" Width="12" Height="12" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="CtxNodeExportJson" Header="Esporta JSON" Click="OnNodeExportJsonClicked">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource IconExport}" Width="12" Height="12" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem x:Name="CtxNodeBlastRadius" Header="Blast Radius" Click="OnBlastRadiusClicked">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource IconBlastRadius}" Width="12" Height="12" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="CtxNodeShowCallers" Header="Mostra Callers" Click="OnShowCallersClicked">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource IconCallers}" Width="12" Height="12" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="CtxNodeShowCallees" Header="Mostra Callees" Click="OnShowCalleesClicked">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource IconCallees}" Width="12" Height="12" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Grid.Resources>

                        <!-- Canvas del Grafo -->
                        <controls:GraphControl x:Name="Graph" SelectionChanged="OnGraphSelectionChanged" />

                        <!-- Pannello Flottante Verticale Comandi Grafo (In alto a destra, Stile Solido Monocromatico) -->
                        <Border x:Name="FloatingHudBorder"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="14"
                                Background="{DynamicResource ThemeBackgroundElevatedBrush}"
                                BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                BoxShadow="0 4 16 0 #40000000"
                                Padding="4">
                            <Border.Styles>
                                <Style Selector="Button">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    <Setter Property="Padding" Value="8,5" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="CornerRadius" Value="4" />
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
                                </Style>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource ThemeBackgroundSurfaceBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                                </Style>
                                <Style Selector="Button PathIcon">
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
                                </Style>
                                <Style Selector="Button:pointerover PathIcon">
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                                </Style>
                                <Style Selector="ComboBox">
                                    <Setter Property="Background" Value="{DynamicResource ThemeBackgroundSurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderSubtleBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="4" />
                                </Style>
                                <Style Selector="ComboBox:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource ThemeBackgroundSurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderDefaultBrush}" />
                                </Style>
                            </Border.Styles>
                            <StackPanel Width="130">
                                <!-- Selettore Modalità Layout -->
                                <StackPanel Spacing="3" Margin="0,2,0,4">
                                    <TextBlock x:Name="HudLayoutLabel" Text="Layout:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMutedBrush}" />
                                    <ComboBox x:Name="LayoutComboBox" SelectedIndex="0" FontSize="11" HorizontalAlignment="Stretch"
                                              Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                              BorderBrush="{DynamicResource ThemeBorderSubtleBrush}"
                                              BorderThickness="1"
                                              CornerRadius="4">
                                        <ComboBoxItem x:Name="LayoutItemStandard" Content="Radiale Standard" />
                                        <ComboBoxItem x:Name="LayoutItemAffinity" Content="Radiale Affinità" />
                                        <ComboBoxItem x:Name="LayoutItemIslands" Content="Cluster Isole" />
                                        <ComboBoxItem x:Name="LayoutItemForce" Content="Force-Directed" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- Selettore Livello Dettaglio / Filtri Simboli -->
                                <StackPanel Spacing="3" Margin="0,2,0,4">
                                    <TextBlock x:Name="HudFilterLabel" Text="Dettaglio:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMutedBrush}" />
                                    <ComboBox x:Name="DetailLevelComboBox" SelectedIndex="0" FontSize="11" HorizontalAlignment="Stretch"
                                              Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                              BorderBrush="{DynamicResource ThemeBorderSubtleBrush}"
                                              BorderThickness="1"
                                              CornerRadius="4">
                                        <ComboBoxItem x:Name="DetailItemAll" Content="Completo (Tutti)" />
                                        <ComboBoxItem x:Name="DetailItemMethodsProps" Content="Metodi &amp; Prop" />
                                        <ComboBoxItem x:Name="DetailItemContainers" Content="Solo Moduli" />
                                        <ComboBoxItem x:Name="DetailItemCustom" Content="Personalizzato" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- Pulsante Flyout Filtri Granulari Categorie -->
                                <Button x:Name="FilterOptionsButton" ToolTip.Tip="Filtra singole categorie di simboli nel grafo">
                                    <Button.Flyout>
                                        <Flyout Placement="LeftEdgeAlignedTop">
                                            <Border Background="{DynamicResource ThemeBackgroundElevatedBrush}" 
                                                    BorderBrush="{DynamicResource ThemeBorderDefaultBrush}" 
                                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Width="200">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="Filtro Categorie Simboli" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                                    <Rectangle Height="1" Fill="{DynamicResource ThemeBorderDefaultBrush}" Margin="0,2" />
                                                    <CheckBox x:Name="FilterMethodsCheckBox" IsChecked="True" FontSize="11" Content="Metodi (Sub/Function)" />
                                                    <CheckBox x:Name="FilterPropertiesCheckBox" IsChecked="True" FontSize="11" Content="Proprietà (Property)" />
                                                    <CheckBox x:Name="FilterFieldsCheckBox" IsChecked="True" FontSize="11" Content="Variabili &amp; Campi" />
                                                    <CheckBox x:Name="FilterConstantsCheckBox" IsChecked="True" FontSize="11" Content="Costanti (Const)" />
                                                    <CheckBox x:Name="FilterTypesCheckBox" IsChecked="True" FontSize="11" Content="Tipi &amp; Enumerazioni" />
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconFilter}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudFilterButtonText" Text="Filtra Membri" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Rectangle Height="1" Fill="{DynamicResource ThemeBorderDefaultBrush}" Margin="4,3" />

                                <!-- Gruppo Vista e Navigazione -->
                                <Button x:Name="ResetViewButton" ToolTip.Tip="Ripristina zoom 100% e centra la visuale">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconTarget}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudResetViewText" Text="Reset Vista" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ExpandAllButton" ToolTip.Tip="Espande tutti i moduli mostrando metodi e proprietà">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconExpandAll}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudExpandAllText" Text="Espandi Tutto" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CollapseAllButton" ToolTip.Tip="Comprime tutti i moduli nascondendo i membri interni">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconCollapseAll}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudCollapseAllText" Text="Comprimi Tutto" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RefreshProjectButton" ToolTip.Tip="Ricarica Progetto da disco e aggiorna cache (Ctrl+R)">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconRefresh}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudRefreshText" Text="Ricarica" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Separatore Sottile -->
                                <Rectangle Height="1" Fill="{DynamicResource ThemeBorderDefaultBrush}" Margin="4,3" />

                                <!-- Gruppo Ispezione e Blast Radius -->
                                <Button x:Name="BlastRadiusButton" ToolTip.Tip="Calcola ed evidenzia l'impatto di modifica (chiamanti indiretti, form e classi impattate)">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconBlastRadius}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudBlastRadiusText" Text="Blast Radius" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ShowCallersButton" ToolTip.Tip="Evidenzia chi chiama la routine selezionata">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconCallers}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudShowCallersText" Text="Mostra Callers" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ShowCalleesButton" ToolTip.Tip="Evidenzia cosa chiama la routine selezionata">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconCallees}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudShowCalleesText" Text="Mostra Callees" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ClearHighlightButton" ToolTip.Tip="Rimuove le evidenziazioni attive">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconClearFilter}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudClearHighlightText" Text="Pulisci Filtri" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Separatore Sottile -->
                                <Rectangle Height="1" Fill="{DynamicResource ThemeBorderDefaultBrush}" Margin="4,3" />

                                <!-- Gruppo Esportazione & Importazione -->
                                <Button x:Name="ExportMarkdownButton" ToolTip.Tip="Esporta l'intero grafo in formato Markdown Repo Map per modelli AI">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconMarkdown}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudExportMarkdownText" Text="Esporta MD" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ExportJsonButton" ToolTip.Tip="Esporta l'intero grafo in formato JSON strutturato">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconExport}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudExportJsonText" Text="Esporta JSON" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ImportJsonButton" ToolTip.Tip="Importa un grafo semantico da file JSON">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconImport}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudImportJsonText" Text="Importa JSON" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Legenda Flottante Colori Nodi & Relazioni (In basso a sinistra, Stile Solido HUD) -->
                        <Border x:Name="GraphLegendBorder"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Margin="14"
                                Background="{DynamicResource ThemeBackgroundElevatedBrush}"
                                BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                BoxShadow="0 4 16 0 #40000000"
                                Padding="10,8">
                            <StackPanel Spacing="6" MaxWidth="320">
                                <!-- Intestazione Legenda con Pulsante Comprimi/Espandi -->
                                <DockPanel LastChildFill="True">
                                    <Button x:Name="ToggleLegendButton"
                                            DockPanel.Dock="Right"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="4,2"
                                            CornerRadius="4"
                                            ToolTip.Tip="Espandi / Comprimi legenda">
                                        <PathIcon x:Name="LegendToggleIcon" Data="{StaticResource IconChevronLeft}" Width="10" Height="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconInfo}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="LegendTitleText" Text="Legenda Nodi &amp; Colori" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Contenuto Dettagliato Legenda -->
                                <StackPanel x:Name="LegendContentPanel" Spacing="6" IsVisible="True">
                                    <Rectangle Height="1" Fill="{DynamicResource ThemeBorderDefaultBrush}" Margin="0,1" />

                                    <!-- Moduli e File (Contenitori) -->
                                    <UniformGrid Columns="2" Margin="0,2">
                                        <!-- Form -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                            <Ellipse Width="10" Height="10" Fill="#4FA8E8" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LegendFormText" Text="Form (.frm)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Modulo Standard -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                            <Ellipse Width="10" Height="10" Fill="#C084F0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LegendModuleText" Text="Modulo (.bas)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Classe -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                            <Ellipse Width="10" Height="10" Fill="#54C08C" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LegendClassText" Text="Classe (.cls)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Controllo Utente -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                            <Ellipse Width="10" Height="10" Fill="#F08C4A" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LegendControlText" Text="Control (.ctl)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <Rectangle Height="1" Fill="{DynamicResource ThemeBorderDefaultBrush}" Margin="0,1" />

                                    <!-- Membri & Routine Interne (Cliccabili per Filtrare) -->
                                    <UniformGrid Columns="2" Margin="0,2">
                                        <!-- Metodo / Sub / Function -->
                                        <Button x:Name="LegendMethodButton" Background="Transparent" BorderThickness="0" Padding="2" HorizontalAlignment="Stretch" Cursor="Hand" ToolTip.Tip="Clicca per mostrare/nascondere Metodi (Sub/Function)">
                                            <StackPanel x:Name="LegendMethodPanel" Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8" Height="8" Fill="#7D7D8E" VerticalAlignment="Center" />
                                                <TextBlock x:Name="LegendMethodText" Text="Sub / Function" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Proprietà -->
                                        <Button x:Name="LegendPropertyButton" Background="Transparent" BorderThickness="0" Padding="2" HorizontalAlignment="Stretch" Cursor="Hand" ToolTip.Tip="Clicca per mostrare/nascondere Proprietà">
                                            <StackPanel x:Name="LegendPropertyPanel" Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8" Height="8" Fill="#E8B838" VerticalAlignment="Center" />
                                                <TextBlock x:Name="LegendPropertyText" Text="Property" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Campo / Variabile -->
                                        <Button x:Name="LegendFieldButton" Background="Transparent" BorderThickness="0" Padding="2" HorizontalAlignment="Stretch" Cursor="Hand" ToolTip.Tip="Clicca per mostrare/nascondere Variabili e Campi">
                                            <StackPanel x:Name="LegendFieldPanel" Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="7" Height="7" Fill="#60A5FA" VerticalAlignment="Center" />
                                                <TextBlock x:Name="LegendFieldText" Text="Field / Var" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Tipo / Enum -->
                                        <Button x:Name="LegendTypeButton" Background="Transparent" BorderThickness="0" Padding="2" HorizontalAlignment="Stretch" Cursor="Hand" ToolTip.Tip="Clicca per mostrare/nascondere Tipi ed Enumerazioni">
                                            <StackPanel x:Name="LegendTypePanel" Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="7" Height="7" Fill="#34D399" VerticalAlignment="Center" />
                                                <TextBlock x:Name="LegendTypeText" Text="Type / Enum" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>

                                    <Rectangle Height="1" Fill="{DynamicResource ThemeBorderDefaultBrush}" Margin="0,1" />

                                    <!-- Relazioni e Archi -->
                                    <UniformGrid Columns="2" Margin="0,2">
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                            <Rectangle Width="14" Height="2.5" Fill="#4AE8D0" VerticalAlignment="Center" RadiusX="1" RadiusY="1" />
                                            <TextBlock x:Name="LegendCallsText" Text="Calls" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                            <Rectangle Width="14" Height="2.5" Fill="#FFA040" VerticalAlignment="Center" RadiusX="1" RadiusY="1" />
                                            <TextBlock x:Name="LegendInstantiatesText" Text="Instantiates (New)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 2: Matrice di Dipendenza (DSM) -->
                <TabItem x:Name="DsmTabItem" ToolTip.Tip="Matrice DSM (Dependency Structure Matrix)">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconMatrix}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="DsmTabHeader" Text="Matrice DSM" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:DsmControl x:Name="Dsm" />
                        <controls:AnalyticsPlaceholderControl x:Name="DsmPlaceholder" />
                    </Grid>
                </TabItem>

                <!-- TAB 3: Treemap Gerarchica delle Metriche -->
                <TabItem x:Name="TreemapTabItem" ToolTip.Tip="Treemap Metriche di Codice">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconTreemap}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="TreemapTabHeader" Text="Treemap Metriche" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:TreemapControl x:Name="Treemap" />
                        <controls:AnalyticsPlaceholderControl x:Name="TreemapPlaceholder" />
                    </Grid>
                </TabItem>

                <!-- TAB 4: Matrice Hotspot di Rischio (Complexity vs Churn) -->
                <TabItem x:Name="HotspotTabItem" ToolTip.Tip="Matrice Hotspot di Rischio">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconHotspot}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="HotspotTabHeader" Text="Hotspot di Rischio" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:HotspotControl x:Name="Hotspot" />
                        <controls:AnalyticsPlaceholderControl x:Name="HotspotPlaceholder" />
                    </Grid>
                </TabItem>

                <!-- TAB 5: Flusso Navigazione Form & UI -->
                <TabItem x:Name="ScreenFlowTabItem" ToolTip.Tip="Flusso Schermate e Navigazione Form">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconScreenFlow}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="ScreenFlowTabHeader" Text="Flusso Schermate" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:ScreenFlowControl x:Name="ScreenFlow" />
                        <controls:AnalyticsPlaceholderControl x:Name="ScreenFlowPlaceholder" />
                    </Grid>
                </TabItem>

                <!-- TAB 6: Control Flow Graph (CFG) a livello di Routine -->
                <TabItem x:Name="ControlFlowTabItem" ToolTip.Tip="Control Flow Graph (CFG) a blocchi">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconControlFlow}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="ControlFlowTabHeader" Text="Control Flow (CFG)" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:ControlFlowControl x:Name="ControlFlow" />
                    </Grid>
                </TabItem>

                <!-- TAB 7: Diagramma di Martin (Main Sequence: A vs I) -->
                <TabItem x:Name="MartinTabItem" ToolTip.Tip="Diagramma di Martin (Abstractness vs Instability)">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconMartin}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="MartinTabHeader" Text="Metriche Martin" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:MartinMetricsControl x:Name="MartinMetrics" />
                        <controls:AnalyticsPlaceholderControl x:Name="MartinPlaceholder" />
                    </Grid>
                </TabItem>

                <!-- TAB 8: Dead Code & Raggiungibilità Entry Point -->
                <TabItem x:Name="DeadCodeTabItem" ToolTip.Tip="Analisi Dead Code e Componenti Orfani">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconDeadCode}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="DeadCodeTabHeader" Text="Dead Code &amp; Orfani" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:DeadCodeControl x:Name="DeadCode" />
                        <controls:AnalyticsPlaceholderControl x:Name="DeadCodePlaceholder" />
                    </Grid>
                </TabItem>

                <!-- TAB 9: Matrice di Stato Condiviso (Global & Shared State Matrix) -->
                <TabItem x:Name="SharedStateTabItem" ToolTip.Tip="Matrice di Stato Globale Condiviso e Mutazioni">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconSharedState}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="SharedStateTabHeader" Text="Stato Condiviso" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:SharedStateControl x:Name="SharedState" />
                        <controls:AnalyticsPlaceholderControl x:Name="SharedStatePlaceholder" />
                    </Grid>
                </TabItem>

                <!-- TAB 10: Temporal Coupling & Co-Change Matrix -->
                <TabItem x:Name="TemporalCouplingTabItem" ToolTip.Tip="Temporal Coupling e Co-Modifiche VCS">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconTemporalCoupling}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="TemporalCouplingTabHeader" Text="Temporal Coupling" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:TemporalCouplingControl x:Name="TemporalCoupling" />
                        <controls:AnalyticsPlaceholderControl x:Name="TemporalCouplingPlaceholder" />
                    </Grid>
                </TabItem>

                <!-- TAB 11: Flussi Architetturali (Chord Diagram / Layered Flow) -->
                <TabItem x:Name="ArchitecturalFlowTabItem" ToolTip.Tip="Flussi Architetturali e Diagramma Chord">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconFlow}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="ArchitecturalFlowTabHeader" Text="Flussi Architetturali" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:ArchitecturalFlowControl x:Name="ArchitecturalFlow" />
                        <controls:AnalyticsPlaceholderControl x:Name="ArchitecturalFlowPlaceholder" />
                    </Grid>
                </TabItem>

                <!-- TAB 12: Mappa Urbana 3D / Isometrica (CodeCity) -->
                <TabItem x:Name="CodeCityTabItem" ToolTip.Tip="Mappa CodeCity 3D / Isometrica Polimetrica">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconCity}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="CodeCityTabHeader" Text="CodeCity 3D" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:CodeCityControl x:Name="CodeCity" />
                        <controls:AnalyticsPlaceholderControl x:Name="CodeCityPlaceholder" />
                    </Grid>
                </TabItem>

                <!-- TAB 13: Coesione & LCOM -->
                <TabItem x:Name="CohesionTabItem" ToolTip.Tip="Analisi Coesione LCOM4 e C&amp;K">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconCohesion}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="CohesionTabHeader" Text="Coesione &amp; LCOM" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:CohesionControl x:Name="Cohesion" />
                        <controls:AnalyticsPlaceholderControl x:Name="CohesionPlaceholder" />
                    </Grid>
                </TabItem>

                <!-- TAB 14: Indice di Manutenibilità -->
                <TabItem x:Name="MaintainabilityTabItem" ToolTip.Tip="Maintainability Index (MI) e Halstead">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconMaintainability}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="MaintainabilityTabHeader" Text="Manutenibilità" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:MaintainabilityControl x:Name="Maintainability" />
                        <controls:AnalyticsPlaceholderControl x:Name="MaintainabilityPlaceholder" />
                    </Grid>
                </TabItem>

                <!-- TAB 15: Regole Architetturali -->
                <TabItem x:Name="ArchitecturalRulesTabItem" ToolTip.Tip="Linter Regole Architetturali">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconArchitecturalRules}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="ArchitecturalRulesTabHeader" Text="Regole Architettura" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:ArchitecturalRulesControl x:Name="ArchitecturalRules" />
                        <controls:AnalyticsPlaceholderControl x:Name="ArchitecturalRulesPlaceholder" />
                    </Grid>
                </TabItem>

                <!-- TAB 16: Duplicazioni e Cloni (CPD) -->
                <TabItem x:Name="CodeCloneTabItem" ToolTip.Tip="Rilevamento Duplicazioni e Cloni (CPD)">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconCodeClone}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="CodeCloneTabHeader" Text="Duplicazioni (CPD)" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:CodeCloneControl x:Name="CodeClone" />
                        <controls:AnalyticsPlaceholderControl x:Name="CodeClonePlaceholder" />
                    </Grid>
                </TabItem>

                <!-- TAB 17: Social Code & Bus Factor -->
                <TabItem x:Name="SocialCodeTabItem" ToolTip.Tip="Social Code Analysis e Bus Factor (Conway)">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconSocialCode}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="SocialCodeTabHeader" Text="Social &amp; Bus Factor" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:SocialCodeControl x:Name="SocialCode" />
                        <controls:AnalyticsPlaceholderControl x:Name="SocialCodePlaceholder" />
                    </Grid>
                </TabItem>

                <!-- TAB 18: Data Flow & Taint Tracking -->
                <TabItem x:Name="DataFlowTabItem" ToolTip.Tip="Data Flow e Taint Tracking Source-Sink">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconDataFlow}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="DataFlowTabHeader" Text="Data Flow &amp; Taint" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:DataFlowControl x:Name="DataFlow" />
                        <controls:AnalyticsPlaceholderControl x:Name="DataFlowPlaceholder" />
                    </Grid>
                </TabItem>

                <!-- TAB 19: API Diff & SemVer -->
                <TabItem x:Name="ApiDiffTabItem" ToolTip.Tip="Confronto Superficie API e Breaking Changes">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconApiDiff}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="ApiDiffTabHeader" Text="API Diff &amp; SemVer" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:ApiDiffControl x:Name="ApiDiff" />
                        <controls:AnalyticsPlaceholderControl x:Name="ApiDiffPlaceholder" />
                    </Grid>
                </TabItem>

                <!-- TAB 20: Matrice CRUD -->
                <TabItem x:Name="CrudMatrixTabItem" ToolTip.Tip="Matrice Operazioni CRUD su Dati">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconCrudMatrix}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="CrudMatrixTabHeader" Text="Matrice CRUD" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:CrudMatrixControl x:Name="CrudMatrix" />
                        <controls:AnalyticsPlaceholderControl x:Name="CrudMatrixPlaceholder" />
                    </Grid>
                </TabItem>

                <!-- TAB 21: Griglia Risultati Blast Radius & Matrice di Rischio -->
                <TabItem x:Name="GridTabItem" ToolTip.Tip="Griglia e Matrice Blast Radius">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconTable}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="GridTabHeader" Text="Griglia Blast Radius" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <views:BlastRadiusGridView x:Name="BlastRadiusGridControl"
                                               RowSelected="OnGridControlRowSelected"
                                               NavigateToNodeRequested="OnGridControlNavigateToNodeRequested"
                                               RecalculateAuditRequested="OnGridControlRecalculateAuditRequested" />
                </TabItem>
            </TabControl>
            </Panel>

            <!-- Splitter Ridimensionamento Pannello Destro -->
            <GridSplitter x:Name="RightGridSplitter" Grid.Column="3"
                          Width="4"
                          Background="{DynamicResource ThemeBorderDefaultBrush}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWestEast" />

            <!-- Pannello Destro: TabControl con Symbol Inspector e Anteprima Codice Sorgente -->
            <Border x:Name="RightPanelContainer" Grid.Column="4"
                    Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                    BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                    BorderThickness="1,0,0,0">
                <TabControl x:Name="RightTabControl" SelectedIndex="0" Padding="0">
                    <TabControl.Styles>
                        <Style Selector="TabItem">
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="12,6" />
                            <Setter Property="Margin" Value="2,2" />
                            <Setter Property="CornerRadius" Value="4" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
                            <Setter Property="MinHeight" Value="28" />
                        </Style>
                        <Style Selector="TabItem PathIcon">
                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
                        </Style>
                        <Style Selector="TabItem:pointerover">
                            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                        </Style>
                        <Style Selector="TabItem:selected">
                            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Style>
                        <Style Selector="TabItem:selected PathIcon">
                            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
                        </Style>
                        <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
                            <Setter Property="IsVisible" Value="False" />
                            <Setter Property="Height" Value="0" />
                            <Setter Property="Opacity" Value="0" />
                        </Style>
                    </TabControl.Styles>

                    <!-- Scheda 1: Symbol Inspector -->
                    <TabItem x:Name="TabItemInspector">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconInspect}" Width="12" Height="12" VerticalAlignment="Center" />
                                <TextBlock x:Name="TabHeaderInspectorText" Text="Inspector" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <views:SymbolInspectorView x:Name="SymbolInspectorControl"
                                                   OpenFileRequested="OnInspectorOpenFileRequested"
                                                   OpenFolderRequested="OnInspectorOpenFolderRequested"
                                                   CopySliceRequested="OnInspectorCopySliceRequested"
                                                   SaveSliceRequested="OnInspectorSaveSliceRequested" />
                    </TabItem>

                    <!-- Scheda 2: Anteprima Codice Sorgente -->
                    <TabItem x:Name="TabItemSourceCode">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconFile}" Width="12" Height="12" VerticalAlignment="Center" />
                                <TextBlock x:Name="TabHeaderSourceCodeText" Text="Codice Sorgente" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <views:SourceCodePreviewView x:Name="SourceCodePreviewControl"
                                                     OpenFileRequested="OnInspectorOpenFileRequested"
                                                     OpenFolderRequested="OnInspectorOpenFolderRequested"
                                                     CopyCodeRequested="OnInspectorCopyCodeRequested" />
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Barra di Stato Inferiore -->
        <Border x:Name="StatusBarBorder" Grid.Row="3" Background="{DynamicResource ThemeBackgroundSecondaryBrush}" Padding="12,5" BorderBrush="{DynamicResource ThemeBorderDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" x:Name="StatusText" Text="Pronto." Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" x:Name="StatusStats" Text="Nodi: 0 | Relazioni: 0" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                
                <!-- Barra di avanzamento per il pre-calcolo delle viste analitiche in background -->
                <StackPanel Grid.Column="2" x:Name="BackgroundAnalyticsPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="14,0,0,0" IsVisible="False">
                    <Rectangle Width="1" Height="12" Fill="{DynamicResource ThemeBorderDefaultBrush}" VerticalAlignment="Center" />
                    <ProgressBar x:Name="BackgroundAnalyticsProgressBar" Width="90" Height="5" Minimum="0" Maximum="10" Value="0" VerticalAlignment="Center" CornerRadius="2.5" />
                    <TextBlock x:Name="BackgroundAnalyticsText" Text="Analisi viste... 0/10" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="3" x:Name="StatusLanguagePanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="False">
                    <Rectangle Width="1" Height="12" Fill="{DynamicResource ThemeBorderDefaultBrush}" VerticalAlignment="Center" />
                    <Border x:Name="StatusLanguageBadge"
                            CornerRadius="3"
                            Padding="6,1"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="StatusLanguageText" FontSize="10" FontWeight="Bold" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Overlay di Caricamento Centrato a Schermo -->
        <views:LoadingOverlayView x:Name="LoadingOverlayControl" Grid.Row="1" Grid.RowSpan="3"
                                  IsVisible="False" ZIndex="999"
                                  CancelRequested="OnLoadingCancelRequested" />

        <!-- Overlay Modale Aggiornamento Disponibile -->
        <views:UpdateModalView x:Name="UpdateModalControl" Grid.Row="1" Grid.RowSpan="3"
                               IsVisible="False" ZIndex="998"
                               UpdateNowRequested="OnUpdateModalNowRequested"
                               UpdateLaterRequested="OnUpdateModalLaterRequested" />

        <!-- Overlay Modale Conferma Esportazione Completata -->
        <views:ExportSuccessModalView x:Name="ExportSuccessModalControl" Grid.Row="1" Grid.RowSpan="3"
                                      IsVisible="False" ZIndex="997"
                                      OpenFolderRequested="OnExportSuccessOpenFolderRequested" />

        <!-- Overlay Modale Conferma Cambio Layout con Nodi Spostati -->
        <views:LayoutConfirmModalView x:Name="LayoutConfirmModalControl" Grid.Row="1" Grid.RowSpan="3"
                                      IsVisible="False" ZIndex="998"
                                      Confirmed="OnLayoutConfirmModalConfirmed" />
    </Grid>
</Window>
