<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Macondo.App.Controls"
        xmlns:models="using:Macondo.App.Models"
        xmlns:services="using:Macondo.App.Services"
        x:Class="Macondo.App.MainWindow"
        Title="Macondo"
        Icon="avares://Macondo/Assets/Icons/icon1_star_knot.ico"
        Width="1400" Height="900"
        Background="{DynamicResource ThemeBackgroundPrimaryBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        DragDrop.AllowDrop="True">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="{Binding $parent[Window].OffScreenMargin}">

        <!-- Barra Superiore Stile IDE (Brand & Menu a Sinistra | Area Trascinamento al Centro | Controlli Finestra a Destra) -->
        <Border x:Name="TopBarBorder" Grid.Row="0"
                Background="{DynamicResource ThemeBackgroundSecondaryBrush}"
                BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                BorderThickness="0,0,0,1" Padding="8,0,0,0" Height="34">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Sinistra: Brand / Logo App + Menu a Discesa -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,16,0" Spacing="6">
                        <Image Source="avares://Macondo/Assets/Icons/icon1_star_knot_512.png" Width="16" Height="16" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <TextBlock x:Name="BrandTitleText" Text="Macondo" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Menu Background="Transparent">
                        <MenuItem x:Name="FileMenu" Header="_File">
                            <MenuItem x:Name="OpenSubMenu" Header="Apri">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" Foreground="#D4A72C" />
                                </MenuItem.Icon>
                                <MenuItem x:Name="OpenProjectFilesMenuItem" Header="Progetto / Gruppo..." InputGesture="Ctrl+Shift+O">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource IconFile}" Width="14" Height="14" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="OpenFolderMenuItem" Header="Cartella..." InputGesture="Ctrl+Shift+Alt+O">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" Foreground="#D4A72C" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem x:Name="RefreshProjectMenuItem" Header="Ricarica Progetto Corrente" InputGesture="Ctrl+R">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14" Foreground="#4AE8D0" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="LoadFixturesMenuItem" Header="Carica Fixtures Test">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconBeaker}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="GenerateFakeMenuItem" Header="Grafo Demo (~500 nodi)">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconZap}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="ExportMarkdownMenuItem" Header="Esporta Repo Map (Markdown)...">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconMarkdown}" Width="14" Height="14" Foreground="#4AE8D0" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ExportJsonMenuItem" Header="Esporta Grafo (JSON)...">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconExport}" Width="14" Height="14" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ImportJsonMenuItem" Header="Importa Grafo (JSON)...">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconImport}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ExportSliceMenuItem" Header="Esporta Context Slice LLM...">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconCopy}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="SettingsMenuItem" Header="Impostazioni..." InputGesture="Ctrl+,">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconSettings}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="ExitMenuItem" Header="Esci" InputGesture="Alt+F4">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconExit}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem x:Name="ViewMenu" Header="_Visualizza">
                            <MenuItem x:Name="ToggleExplorerMenuItem" Header="Mostra/Nascondi Project Explorer" InputGesture="Ctrl+B">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconPanelLeft}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ToggleInspectorMenuItem" Header="Mostra/Nascondi Symbol Inspector" InputGesture="Ctrl+I">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconPanelRight}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="ResetViewMenuItem" Header="Reset Vista">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconTarget}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ExpandAllMenuItem" Header="Espandi Tutto">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconExpandAll}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="CollapseAllMenuItem" Header="Comprimi Tutto">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconCollapseAll}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="FilterDetailLevelMenuItem" Header="Filtro Livelli Simboli">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconFilter}" Width="14" Height="14" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                                <MenuItem x:Name="FilterAllMenuItem" Header="Completo (Tutti i Membri)" />
                                <MenuItem x:Name="FilterMethodsPropsMenuItem" Header="Metodi &amp; Proprietà" />
                                <MenuItem x:Name="FilterContainersOnlyMenuItem" Header="Solo Contenitori (Moduli)" />
                                <Separator />
                                <MenuItem x:Name="FilterMethodsMenuItem" Header="Mostra Metodi (Sub / Function)" />
                                <MenuItem x:Name="FilterPropertiesMenuItem" Header="Mostra Proprietà" />
                                <MenuItem x:Name="FilterFieldsMenuItem" Header="Mostra Campi e Variabili" />
                                <MenuItem x:Name="FilterConstantsMenuItem" Header="Mostra Costanti" />
                                <MenuItem x:Name="FilterTypesMenuItem" Header="Mostra Tipi ed Enumerazioni" />
                            </MenuItem>
                            <MenuItem x:Name="FilterProjectsMenuItem" Header="Filtra Progetti" IsVisible="False">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconProject}" Width="14" Height="14" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="GraphLayoutMenuItem" Header="Disposizione Grafo">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconGraph}" Width="14" Height="14" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                                <MenuItem x:Name="LayoutStandardMenuItem" Header="Radiale Standard" />
                                <MenuItem x:Name="LayoutAffinityMenuItem" Header="Radiale per Affinità" />
                                <MenuItem x:Name="LayoutIslandsMenuItem" Header="Cluster a Isole (Sottosistemi)" />
                                <MenuItem x:Name="LayoutForceMenuItem" Header="Force-Directed (Fisica a Molle)" />
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="ToggleHoverSelectionMenuItem" Header="Selezione al Passaggio del Mouse" Click="OnToggleHoverSelectionClicked">
                                <MenuItem.Icon>
                                    <PathIcon x:Name="HoverSelectionCheckIcon" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem x:Name="AnalysisMenu" Header="_Analisi">
                            <MenuItem x:Name="BlastRadiusMenuItem" Header="Calcola Blast Radius" InputGesture="F5">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconBlastRadius}" Width="14" Height="14" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ShowCallersMenuItem" Header="Mostra Callers">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconCallers}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ShowCalleesMenuItem" Header="Mostra Callees">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconCallees}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="ClearHighlightMenuItem" Header="Pulisci Filtri">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconClearFilter}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem x:Name="HelpMenu" Header="_Aiuto">
                            <MenuItem x:Name="InfoMenuItem" Header="Guida &amp; Concetti..." InputGesture="F1">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconHelp}" Width="14" Height="14" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="CheckUpdatesMenuItem" Header="Verifica Aggiornamenti...">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconUpdate}" Width="14" Height="14" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="ResetSettingsMenuItem" Header="Ripristina Impostazioni Predefinite...">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14" Foreground="{DynamicResource ThemeAccentBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ClearCacheMenuItem" Header="Pulisci Cache Progetti...">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14" Foreground="#FF5555" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <!-- Centro: Area di Trascinamento Finestra -->
                <Border Grid.Column="1" Background="Transparent"
                        PointerPressed="OnTitleBarPointerPressed"
                        DoubleTapped="OnTitleBarDoubleTapped" />

                <!-- Destra: Pulsanti di Controllo Finestra e Impostazioni -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <StackPanel.Styles>
                        <Style Selector="Button.caption-btn">
                            <Setter Property="Width" Value="46" />
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="CornerRadius" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
                        </Style>
                        <Style Selector="Button.caption-btn:pointerover">
                            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                        </Style>
                        <Style Selector="Button.caption-close:pointerover">
                            <Setter Property="Background" Value="#E81123" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Style>
                    </StackPanel.Styles>

                    <Button x:Name="SettingsButton" Classes="caption-btn" ToolTip.Tip="Impostazioni (Ctrl+,)">
                        <PathIcon Data="{StaticResource IconSettings}" Width="12" Height="12" />
                    </Button>
                    <Button x:Name="MinimizeButton" Classes="caption-btn" ToolTip.Tip="Riduci a icona">
                        <PathIcon Data="{StaticResource IconWindowMinimize}" Width="10" Height="10" />
                    </Button>
                    <Button x:Name="MaximizeButton" Classes="caption-btn" ToolTip.Tip="Ingrandisci / Ripristina">
                        <PathIcon x:Name="MaximizeIcon" Data="{StaticResource IconWindowMaximize}" Width="10" Height="10" />
                    </Button>
                    <Button x:Name="CloseButton" Classes="caption-btn caption-close" ToolTip.Tip="Chiudi">
                        <PathIcon Data="{StaticResource IconWindowClose}" Width="10" Height="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Nuova Riga Toolbar Dedicata: Toggle Explorer (Sinistra) | Barra Ricerca (Centro) | Toggle Inspector (Destra) -->
        <Border x:Name="SearchRowBorder" Grid.Row="1"
                Background="{DynamicResource ThemeBackgroundSecondaryBrush}"
                BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                BorderThickness="0,0,0,1" Height="36" Padding="8,0">
            <Border.Styles>
                <Style Selector="Button.toggle-panel-btn">
                    <Setter Property="Width" Value="30" />
                    <Setter Property="Height" Value="26" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="4" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style Selector="Button.toggle-panel-btn PathIcon">
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
                </Style>
                <Style Selector="Button.toggle-panel-btn:pointerover">
                    <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
                </Style>
                <Style Selector="Button.toggle-panel-btn:pointerover PathIcon">
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                </Style>
                <Style Selector="Button.toggle-panel-btn.active">
                    <Setter Property="Background" Value="{DynamicResource ThemeBackgroundSurfaceBrush}" />
                </Style>
                <Style Selector="Button.toggle-panel-btn.active PathIcon">
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                </Style>
            </Border.Styles>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Sinistra: Pulsante Mostra/Nascondi Project Explorer & Selettore VCS (Git / SVN) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="ToggleExplorerTopButton"
                            Classes="toggle-panel-btn"
                            ToolTip.Tip="Mostra/Nascondi Project Explorer (Ctrl+B)">
                        <PathIcon x:Name="ToggleExplorerTopIcon" Data="{StaticResource IconPanelLeft}" Width="14" Height="14" />
                    </Button>

                    <!-- VCS (Git & SVN) Branch Button & Popup -->
                    <Panel x:Name="GitBranchPanel" IsVisible="False" VerticalAlignment="Center">
                        <Button x:Name="GitBranchButton"
                                Height="26"
                                Padding="8,0"
                                Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                FontSize="11"
                                MaxWidth="190"
                                ToolTip.Tip="Branch VCS corrente. Clicca per cambiare branch.">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon x:Name="GitBranchIcon" Data="{StaticResource IconGitBranch}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="GitBranchText" Text="master" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                            </StackPanel>
                        </Button>

                        <!-- Popup Selezione e Switch Branch VCS (Git / SVN) -->
                        <Popup x:Name="GitBranchPopup"
                               PlacementTarget="{Binding ElementName=GitBranchButton}"
                               Placement="Bottom"
                               IsLightDismissEnabled="True"
                               VerticalOffset="4">
                            <Border Background="{DynamicResource ThemeBackgroundElevatedBrush}"
                                    BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    BoxShadow="0 8 24 0 #40000000"
                                    MinWidth="260"
                                    MaxWidth="360"
                                    MaxHeight="320"
                                    Padding="8">
                                <DockPanel>
                                    <TextBlock x:Name="GitBranchPopupTitle"
                                               DockPanel.Dock="Top"
                                               Text="Cambia Branch"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                               Margin="4,2,4,6" />
                                    <TextBox x:Name="GitBranchSearchBox"
                                             DockPanel.Dock="Top"
                                             Watermark="Cerca branch..."
                                             FontSize="11"
                                             Margin="0,0,0,6"
                                             TextChanged="OnGitBranchSearchTextChanged" />
                                    <ListBox x:Name="GitBranchListBox"
                                             Background="Transparent"
                                             SelectionMode="Single"
                                             SelectionChanged="OnGitBranchSelected">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="services:VcsBranchInfo">
                                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="2">
                                                    <PathIcon Grid.Column="0" Data="{StaticResource IconVcsBranch}" Width="11" Height="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" />
                                                    <PathIcon Grid.Column="2" Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" IsVisible="{Binding IsCurrent}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Panel>
                </StackPanel>

                <!-- Centro: Casella di Ricerca Dedicata Centrata -->
                <Panel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Panel.Styles>
                        <Style Selector="TextBox#SearchBox">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundSurfaceBrush}" />
                            <Setter Property="CornerRadius" Value="4" />
                        </Style>
                        <Style Selector="TextBox#SearchBox:pointerover /template/ Border#PART_BorderElement">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
                        </Style>
                        <Style Selector="TextBox#SearchBox:focus /template/ Border#PART_BorderElement">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
                        </Style>
                    </Panel.Styles>
                    <TextBox x:Name="SearchBox"
                             Width="460"
                             Height="26"
                             MinHeight="26"
                             FontSize="11"
                             Padding="6,1"
                             BorderThickness="0"
                             BorderBrush="Transparent"
                             Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                             CornerRadius="4"
                             VerticalContentAlignment="Center"
                             Watermark="Cerca simbolo nel grafo..."
                             TextChanged="OnSearchTextChanged"
                             KeyDown="OnSearchBoxKeyDown">
                        <TextBox.InnerLeftContent>
                            <PathIcon Data="{StaticResource IconSearch}" Width="12" Height="12" VerticalAlignment="Center" Margin="6,0,4,0" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                        </TextBox.InnerLeftContent>
                        <TextBox.InnerRightContent>
                            <Border Background="{DynamicResource ThemeBackgroundElevatedBrush}"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="3"
                                    Padding="5,1"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Ctrl + F"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </Border>
                        </TextBox.InnerRightContent>
                    </TextBox>

                    <!-- Dropdown Risultati Multipli -->
                    <Popup x:Name="SearchResultsPopup"
                           PlacementTarget="{Binding ElementName=SearchBox}"
                           Placement="Bottom"
                           IsLightDismissEnabled="True"
                           VerticalOffset="4">
                        <Border Background="{DynamicResource ThemeBackgroundElevatedBrush}"
                                BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                BoxShadow="0 8 24 0 #40000000"
                                MinWidth="380"
                                MaxWidth="520"
                                MaxHeight="320"
                                Padding="6">
                            <DockPanel>
                                <TextBlock x:Name="SearchResultsHeader"
                                           DockPanel.Dock="Top"
                                           Text="Risultati trovati:"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                           Margin="6,4,6,6" />
                                <ListBox x:Name="SearchResultsList"
                                         Background="Transparent"
                                         SelectionChanged="OnSearchResultSelected"
                                         KeyDown="OnSearchResultsListKeyDown">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="models:GraphNode">
                                            <Grid ColumnDefinitions="Auto,*" Margin="2">
                                                <Border Grid.Column="0"
                                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="4,1"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding QualifiedName}" FontSize="10" Foreground="{DynamicResource ThemeTextMutedBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Popup>
                </Panel>

                <!-- Destra: Pulsante Mostra/Nascondi Symbol Inspector -->
                <Button Grid.Column="2" x:Name="ToggleInspectorTopButton"
                        Classes="toggle-panel-btn"
                        ToolTip.Tip="Mostra/Nascondi Symbol Inspector (Ctrl+I)">
                    <PathIcon x:Name="ToggleInspectorTopIcon" Data="{StaticResource IconPanelRight}" Width="14" Height="14" />
                </Button>
            </Grid>
        </Border>

        <!-- Area Centrale: Explorer | Graph + Floating Actions | Inspector -->
        <Grid x:Name="CentralGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180" MaxWidth="600" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="360" MinWidth="240" MaxWidth="800" />
            </Grid.ColumnDefinitions>

            <!-- Pannello Sinistro: Project Explorer -->
            <Border x:Name="ExplorerBorder" Grid.Column="0"
                    Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                    BorderThickness="0" Padding="8">
                <Border.Resources>
                    <ContextMenu x:Key="ExplorerFileContextMenu">
                        <MenuItem x:Name="CtxExplorerOpenFile" Header="Apri file originale" Click="OnExplorerContextMenuOpenFile">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource IconFile}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="CtxExplorerOpenFolder" Header="Mostra nella cartella" Click="OnExplorerContextMenuOpenFolder">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource IconFolder}" Width="12" Height="12" Foreground="#D4A72C" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem x:Name="CtxExplorerCopyPath" Header="Copia percorso file" Click="OnExplorerContextMenuCopyPath">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource IconCopy}" Width="12" Height="12" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.Resources>
                <DockPanel>
                    <!-- Intestazione Explorer con Barra Filtro Progetti Rapida -->
                    <StackPanel DockPanel.Dock="Top" Margin="4,4,4,6" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconFolder}" Width="13" Height="13" Foreground="#D4A72C" VerticalAlignment="Center" />
                                <TextBlock x:Name="ExplorerTitleText" Text="Project Explorer" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>                        
                        </Grid>

                        <!-- Barra Filtro Progetti Rapida (Visibile quando ci sono più progetti nel workspace) -->
                        <Border x:Name="ExplorerProjectFilterBar"
                                IsVisible="False"
                                Background="{DynamicResource ThemeBackgroundElevatedBrush}"
                                BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,3"
                                Margin="0,2,0,2">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconProject}" Width="11" Height="11" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ExplorerProjectsCountText" Text="2/3 Progetti visibili" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button x:Name="ExplorerProjectsSelectAllButton" Grid.Column="1" Content="Tutti" FontSize="10" Padding="6,1" Background="{DynamicResource ThemeBackgroundSurfaceBrush}" Click="OnProjectsSelectAllClicked" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TreeView x:Name="ExplorerTree" SelectionChanged="OnExplorerSelectionChanged" DoubleTapped="OnExplorerDoubleTapped">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate DataType="models:ExplorerTreeItem" ItemsSource="{Binding Children}">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,1" Background="Transparent" ToolTip.Tip="{Binding ToolTipText}">
                                    <!-- CheckBox visibilità solo per i nodi progetto nel workspace multi-progetto -->
                                    <CheckBox Grid.Column="0"
                                              IsVisible="{Binding IsProjectRoot}"
                                              IsChecked="{Binding IsProjectVisible, Mode=TwoWay}"
                                              Margin="0,0,4,0"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="Attiva o disattiva la visualizzazione di questo progetto in tutte le analisi"
                                              Click="OnExplorerProjectCheckBoxClick"
                                              CommandParameter="{Binding}" />

                                    <Border Grid.Column="1"
                                            Background="{Binding BadgeBackground}"
                                            CornerRadius="3"
                                            Padding="4,1"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KindBadge}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding BadgeForeground}" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayText}" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="3"
                                            IsVisible="{Binding HasFile}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="3,1"
                                            Margin="4,0,0,0"
                                            ToolTip.Tip="Apri file originale"
                                            Click="OnExplorerOpenItemButtonClick"
                                            CommandParameter="{Binding}">
                                        <PathIcon Data="{StaticResource IconExport}" Width="10" Height="10" Foreground="{DynamicResource ThemeTextMutedBrush}" />
                                    </Button>
                                </Grid>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Splitter Ridimensionamento Pannello Sinistro (Project Explorer) -->
            <GridSplitter x:Name="LeftGridSplitter" Grid.Column="1"
                          Width="4"
                          Background="{DynamicResource ThemeBorderDefaultBrush}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWestEast" />

            <!-- Pannello Centrale con Tab (Vista Grafo / Griglia Blast Radius) -->
            <TabControl Grid.Column="2" x:Name="CentralTabControl" SelectedIndex="0" Padding="0">
                <TabControl.Styles>
                    <Style Selector="TabItem">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="Padding" Value="14,6" />
                        <Setter Property="Margin" Value="2,2" />
                        <Setter Property="CornerRadius" Value="4" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
                        <Setter Property="MinHeight" Value="28" />
                    </Style>
                    <Style Selector="TabItem PathIcon">
                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
                    </Style>
                    <Style Selector="TabItem:pointerover">
                        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                    </Style>
                    <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
                        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
                    </Style>
                    <Style Selector="TabItem:pointerover PathIcon">
                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                    </Style>
                    <Style Selector="TabItem:selected">
                        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundSurfaceBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                    <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
                        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundSurfaceBrush}" />
                    </Style>
                    <Style Selector="TabItem:selected PathIcon">
                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                    </Style>
                    <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
                        <Setter Property="IsVisible" Value="False" />
                        <Setter Property="Height" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Opacity" Value="0" />
                    </Style>
                    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
                        <Setter Property="IsVisible" Value="False" />
                        <Setter Property="Height" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Opacity" Value="0" />
                    </Style>
                    <Style Selector="TabItem:pointerover /template/ Border#PART_SelectedPipe">
                        <Setter Property="IsVisible" Value="False" />
                        <Setter Property="Height" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Opacity" Value="0" />
                    </Style>
                    <Style Selector="TabItem:selected:pointerover /template/ Border#PART_SelectedPipe">
                        <Setter Property="IsVisible" Value="False" />
                        <Setter Property="Height" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Opacity" Value="0" />
                    </Style>
                </TabControl.Styles>

                <!-- TAB 1: Canvas Interattivo del Grafo con Floating HUD -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconGraph}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="GraphTabHeader" Text="Vista Grafo" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <!-- Canvas del Grafo -->
                        <controls:GraphControl x:Name="Graph" SelectionChanged="OnGraphSelectionChanged" />

                        <!-- Pannello Flottante Verticale Comandi Grafo (In alto a destra, Stile Solido Monocromatico) -->
                        <Border x:Name="FloatingHudBorder"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="14"
                                Background="{DynamicResource ThemeBackgroundElevatedBrush}"
                                BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                BoxShadow="0 4 16 0 #40000000"
                                Padding="4">
                            <Border.Styles>
                                <Style Selector="Button">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    <Setter Property="Padding" Value="8,5" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="CornerRadius" Value="4" />
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
                                </Style>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource ThemeBackgroundSurfaceBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                                </Style>
                                <Style Selector="Button PathIcon">
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
                                </Style>
                                <Style Selector="Button:pointerover PathIcon">
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                                </Style>
                                <Style Selector="ComboBox">
                                    <Setter Property="Background" Value="{DynamicResource ThemeBackgroundSurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderSubtleBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="4" />
                                </Style>
                                <Style Selector="ComboBox:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource ThemeBackgroundSurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderDefaultBrush}" />
                                </Style>
                            </Border.Styles>
                            <StackPanel Width="130">
                                <!-- Selettore Modalità Layout -->
                                <StackPanel Spacing="3" Margin="0,2,0,4">
                                    <TextBlock x:Name="HudLayoutLabel" Text="Layout:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMutedBrush}" />
                                    <ComboBox x:Name="LayoutComboBox" SelectedIndex="0" FontSize="11" HorizontalAlignment="Stretch"
                                              Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                              BorderBrush="{DynamicResource ThemeBorderSubtleBrush}"
                                              BorderThickness="1"
                                              CornerRadius="4">
                                        <ComboBoxItem x:Name="LayoutItemStandard" Content="Radiale Standard" />
                                        <ComboBoxItem x:Name="LayoutItemAffinity" Content="Radiale Affinità" />
                                        <ComboBoxItem x:Name="LayoutItemIslands" Content="Cluster Isole" />
                                        <ComboBoxItem x:Name="LayoutItemForce" Content="Force-Directed" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- Selettore Livello Dettaglio / Filtri Simboli -->
                                <StackPanel Spacing="3" Margin="0,2,0,4">
                                    <TextBlock x:Name="HudFilterLabel" Text="Dettaglio:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMutedBrush}" />
                                    <ComboBox x:Name="DetailLevelComboBox" SelectedIndex="0" FontSize="11" HorizontalAlignment="Stretch"
                                              Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                              BorderBrush="{DynamicResource ThemeBorderSubtleBrush}"
                                              BorderThickness="1"
                                              CornerRadius="4">
                                        <ComboBoxItem x:Name="DetailItemAll" Content="Completo (Tutti)" />
                                        <ComboBoxItem x:Name="DetailItemMethodsProps" Content="Metodi &amp; Prop" />
                                        <ComboBoxItem x:Name="DetailItemContainers" Content="Solo Moduli" />
                                        <ComboBoxItem x:Name="DetailItemCustom" Content="Personalizzato" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- Pulsante Flyout Filtri Granulari Categorie -->
                                <Button x:Name="FilterOptionsButton" ToolTip.Tip="Filtra singole categorie di simboli nel grafo">
                                    <Button.Flyout>
                                        <Flyout Placement="LeftEdgeAlignedTop">
                                            <Border Background="{DynamicResource ThemeBackgroundElevatedBrush}" 
                                                    BorderBrush="{DynamicResource ThemeBorderDefaultBrush}" 
                                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Width="200">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="Filtro Categorie Simboli" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                                    <Rectangle Height="1" Fill="{DynamicResource ThemeBorderDefaultBrush}" Margin="0,2" />
                                                    <CheckBox x:Name="FilterMethodsCheckBox" IsChecked="True" FontSize="11" Content="Metodi (Sub/Function)" />
                                                    <CheckBox x:Name="FilterPropertiesCheckBox" IsChecked="True" FontSize="11" Content="Proprietà (Property)" />
                                                    <CheckBox x:Name="FilterFieldsCheckBox" IsChecked="True" FontSize="11" Content="Variabili &amp; Campi" />
                                                    <CheckBox x:Name="FilterConstantsCheckBox" IsChecked="True" FontSize="11" Content="Costanti (Const)" />
                                                    <CheckBox x:Name="FilterTypesCheckBox" IsChecked="True" FontSize="11" Content="Tipi &amp; Enumerazioni" />
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconFilter}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudFilterButtonText" Text="Filtra Membri" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Rectangle Height="1" Fill="{DynamicResource ThemeBorderDefaultBrush}" Margin="4,3" />

                                <!-- Gruppo Vista e Navigazione -->
                                <Button x:Name="ResetViewButton" ToolTip.Tip="Ripristina zoom 100% e centra la visuale">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconTarget}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudResetViewText" Text="Reset Vista" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ExpandAllButton" ToolTip.Tip="Espande tutti i moduli mostrando metodi e proprietà">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconExpandAll}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudExpandAllText" Text="Espandi Tutto" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CollapseAllButton" ToolTip.Tip="Comprime tutti i moduli nascondendo i membri interni">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconCollapseAll}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudCollapseAllText" Text="Comprimi Tutto" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RefreshProjectButton" ToolTip.Tip="Ricarica Progetto da disco e aggiorna cache (Ctrl+R)">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconRefresh}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudRefreshText" Text="Ricarica" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Separatore Sottile -->
                                <Rectangle Height="1" Fill="{DynamicResource ThemeBorderDefaultBrush}" Margin="4,3" />

                                <!-- Gruppo Ispezione e Blast Radius -->
                                <Button x:Name="BlastRadiusButton" ToolTip.Tip="Calcola ed evidenzia l'impatto di modifica (chiamanti indiretti, form e classi impattate)">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconBlastRadius}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudBlastRadiusText" Text="Blast Radius" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ShowCallersButton" ToolTip.Tip="Evidenzia chi chiama la routine selezionata">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconCallers}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudShowCallersText" Text="Mostra Callers" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ShowCalleesButton" ToolTip.Tip="Evidenzia cosa chiama la routine selezionata">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconCallees}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudShowCalleesText" Text="Mostra Callees" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ClearHighlightButton" ToolTip.Tip="Rimuove le evidenziazioni attive">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconClearFilter}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudClearHighlightText" Text="Pulisci Filtri" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Separatore Sottile -->
                                <Rectangle Height="1" Fill="{DynamicResource ThemeBorderDefaultBrush}" Margin="4,3" />

                                <!-- Gruppo Esportazione & Importazione -->
                                <Button x:Name="ExportMarkdownButton" ToolTip.Tip="Esporta l'intero grafo in formato Markdown Repo Map per modelli AI">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconMarkdown}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudExportMarkdownText" Text="Esporta MD" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ExportJsonButton" ToolTip.Tip="Esporta l'intero grafo in formato JSON strutturato">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconExport}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudExportJsonText" Text="Esporta JSON" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ImportJsonButton" ToolTip.Tip="Importa un grafo semantico da file JSON">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconImport}" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HudImportJsonText" Text="Importa JSON" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Legenda Flottante Colori Nodi & Relazioni (In basso a sinistra, Stile Solido HUD) -->
                        <Border x:Name="GraphLegendBorder"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Margin="14"
                                Background="{DynamicResource ThemeBackgroundElevatedBrush}"
                                BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                BoxShadow="0 4 16 0 #40000000"
                                Padding="10,8">
                            <StackPanel Spacing="6" MaxWidth="320">
                                <!-- Intestazione Legenda con Pulsante Comprimi/Espandi -->
                                <DockPanel LastChildFill="True">
                                    <Button x:Name="ToggleLegendButton"
                                            DockPanel.Dock="Right"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="4,2"
                                            CornerRadius="4"
                                            ToolTip.Tip="Espandi / Comprimi legenda">
                                        <PathIcon x:Name="LegendToggleIcon" Data="{StaticResource IconChevronLeft}" Width="10" Height="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconInfo}" Width="12" Height="12" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="LegendTitleText" Text="Legenda Nodi &amp; Colori" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Contenuto Dettagliato Legenda -->
                                <StackPanel x:Name="LegendContentPanel" Spacing="6" IsVisible="True">
                                    <Rectangle Height="1" Fill="{DynamicResource ThemeBorderDefaultBrush}" Margin="0,1" />

                                    <!-- Moduli e File VB6 (Contenitori) -->
                                    <UniformGrid Columns="2" Margin="0,2">
                                        <!-- Form -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                            <Ellipse Width="10" Height="10" Fill="#4FA8E8" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LegendFormText" Text="Form (.frm)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Modulo Standard -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                            <Ellipse Width="10" Height="10" Fill="#C084F0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LegendModuleText" Text="Modulo (.bas)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Classe -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                            <Ellipse Width="10" Height="10" Fill="#54C08C" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LegendClassText" Text="Classe (.cls)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Controllo Utente -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                            <Ellipse Width="10" Height="10" Fill="#F08C4A" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LegendControlText" Text="Control (.ctl)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <Rectangle Height="1" Fill="{DynamicResource ThemeBorderDefaultBrush}" Margin="0,1" />

                                    <!-- Membri & Routine Interne (Cliccabili per Filtrare) -->
                                    <UniformGrid Columns="2" Margin="0,2">
                                        <!-- Metodo / Sub / Function -->
                                        <Button x:Name="LegendMethodButton" Background="Transparent" BorderThickness="0" Padding="2" HorizontalAlignment="Stretch" Cursor="Hand" ToolTip.Tip="Clicca per mostrare/nascondere Metodi (Sub/Function)">
                                            <StackPanel x:Name="LegendMethodPanel" Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8" Height="8" Fill="#7D7D8E" VerticalAlignment="Center" />
                                                <TextBlock x:Name="LegendMethodText" Text="Sub / Function" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Proprietà -->
                                        <Button x:Name="LegendPropertyButton" Background="Transparent" BorderThickness="0" Padding="2" HorizontalAlignment="Stretch" Cursor="Hand" ToolTip.Tip="Clicca per mostrare/nascondere Proprietà">
                                            <StackPanel x:Name="LegendPropertyPanel" Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8" Height="8" Fill="#E8B838" VerticalAlignment="Center" />
                                                <TextBlock x:Name="LegendPropertyText" Text="Property" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Campo / Variabile -->
                                        <Button x:Name="LegendFieldButton" Background="Transparent" BorderThickness="0" Padding="2" HorizontalAlignment="Stretch" Cursor="Hand" ToolTip.Tip="Clicca per mostrare/nascondere Variabili e Campi">
                                            <StackPanel x:Name="LegendFieldPanel" Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="7" Height="7" Fill="#60A5FA" VerticalAlignment="Center" />
                                                <TextBlock x:Name="LegendFieldText" Text="Field / Var" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Tipo / Enum -->
                                        <Button x:Name="LegendTypeButton" Background="Transparent" BorderThickness="0" Padding="2" HorizontalAlignment="Stretch" Cursor="Hand" ToolTip.Tip="Clicca per mostrare/nascondere Tipi ed Enumerazioni">
                                            <StackPanel x:Name="LegendTypePanel" Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="7" Height="7" Fill="#34D399" VerticalAlignment="Center" />
                                                <TextBlock x:Name="LegendTypeText" Text="Type / Enum" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>

                                    <Rectangle Height="1" Fill="{DynamicResource ThemeBorderDefaultBrush}" Margin="0,1" />

                                    <!-- Relazioni e Archi -->
                                    <UniformGrid Columns="2" Margin="0,2">
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                            <Rectangle Width="14" Height="2.5" Fill="#4AE8D0" VerticalAlignment="Center" RadiusX="1" RadiusY="1" />
                                            <TextBlock x:Name="LegendCallsText" Text="Calls" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                            <Rectangle Width="14" Height="2.5" Fill="#FFA040" VerticalAlignment="Center" RadiusX="1" RadiusY="1" />
                                            <TextBlock x:Name="LegendInstantiatesText" Text="Instantiates (New)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 2: Matrice di Dipendenza (DSM) -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconMatrix}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="DsmTabHeader" Text="Matrice DSM" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:DsmControl x:Name="Dsm" />
                    </Grid>
                </TabItem>

                <!-- TAB 3: Treemap Gerarchica delle Metriche -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconTreemap}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="TreemapTabHeader" Text="Treemap Metriche" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:TreemapControl x:Name="Treemap" />
                    </Grid>
                </TabItem>

                <!-- TAB 4: Matrice Hotspot di Rischio (Complexity vs Churn) -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconHotspot}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="HotspotTabHeader" Text="Hotspot di Rischio" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:HotspotControl x:Name="Hotspot" />
                    </Grid>
                </TabItem>

                <!-- TAB 5: Flusso Navigazione Form & UI -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconScreenFlow}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="ScreenFlowTabHeader" Text="Flusso Schermate" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:ScreenFlowControl x:Name="ScreenFlow" />
                    </Grid>
                </TabItem>

                <!-- TAB 6: Control Flow Graph (CFG) a livello di Routine -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconControlFlow}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="ControlFlowTabHeader" Text="Control Flow (CFG)" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <controls:ControlFlowControl x:Name="ControlFlow" />
                    </Grid>
                </TabItem>

                <!-- TAB 7: Griglia Risultati Blast Radius & Matrice di Rischio -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconTable}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="GridTabHeader" Text="Griglia Blast Radius" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid RowDefinitions="Auto,*">
                        <!-- Toolbar della Griglia: Filtri e Statistiche -->
                        <Border x:Name="GridToolbarBorder" Grid.Row="0"
                                Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                BorderThickness="0,0,0,1" Padding="12,8">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                <!-- Filtro Testo nella Tabella -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock x:Name="GridFilterLabel" Text="Filtra:" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                                    <TextBox x:Name="GridFilterTextBox"
                                             Width="180"
                                             Watermark="Nome routine o modulo..."
                                             FontSize="11"
                                             TextChanged="OnGridFilterTextChanged" />
                                </StackPanel>

                                <!-- Filtro Livello di Rischio -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <TextBlock x:Name="GridRiskLabel" Text="Rischio:" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                                    <ComboBox x:Name="RiskFilterComboBox" SelectedIndex="0" FontSize="11" Width="130" SelectionChanged="OnRiskFilterChanged">
                                        <ComboBoxItem x:Name="RiskItemAll" Content="Tutti i Livelli" />
                                        <ComboBoxItem x:Name="RiskItemCritical" Content="Critico" />
                                        <ComboBoxItem x:Name="RiskItemHigh" Content="Alto" />
                                        <ComboBoxItem x:Name="RiskItemMedium" Content="Medio" />
                                        <ComboBoxItem x:Name="RiskItemLow" Content="Basso" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- Contatore Riassuntivo -->
                                <TextBlock Grid.Column="2" x:Name="GridStatsTextBlock"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           FontSize="11"
                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                           Margin="0,0,16,0" />

                                <!-- Pulsante Aggiorna / Ricalcola Audit -->
                                <Button Grid.Column="3" x:Name="RefreshGridButton"
                                        FontSize="11"
                                        Padding="10,5"
                                        ToolTip.Tip="Ricalcola la matrice di rischio e impatto per tutte le routine"
                                        Click="OnRefreshGridClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconRefresh}" Width="11" Height="11" Foreground="#4AE8D0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="RefreshGridButtonText" Text="Ricalcola Audit" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Tabella Risultati Blast Radius (DataGrid) -->
                        <DataGrid Grid.Row="1" x:Name="BlastRadiusDataGrid"
                                  x:DataType="models:BlastRadiusGridRow"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  CanUserResizeColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                  RowBackground="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                  SelectionMode="Single"
                                  SelectionChanged="OnGridRowSelectionChanged"
                                  DoubleTapped="OnGridRowDoubleTapped">
                            <DataGrid.Columns>
                                <!-- Progetto / Workspace -->
                                <DataGridTextColumn Header="Progetto"
                                                    Binding="{Binding ProjectName}"
                                                    Width="1.2*" />

                                <!-- Simbolo / Routine -->
                                <DataGridTextColumn Header="Routine / Simbolo"
                                                    Binding="{Binding Name}"
                                                    Width="2*" />

                                <!-- Modulo / Container -->
                                <DataGridTextColumn Header="Modulo / Container"
                                                    Binding="{Binding ContainerName}"
                                                    Width="1.5*" />

                                <!-- Chiamanti Diretti -->
                                <DataGridTextColumn Header="Chiamanti Diretti"
                                                    Binding="{Binding DirectCallersCount}"
                                                    Width="120" />

                                <!-- Chiamanti Indiretti -->
                                <DataGridTextColumn Header="Chiamanti Indiretti"
                                                    Binding="{Binding IndirectCallersCount}"
                                                    Width="130" />

                                <!-- Profondità Max -->
                                <DataGridTextColumn Header="Profondità"
                                                    Binding="{Binding MaxDepth}"
                                                    Width="90" />

                                <!-- Livello di Rischio (Badge Colorato) -->
                                <DataGridTemplateColumn Header="Rischio" Width="100" SortMemberPath="RiskLevel">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="models:BlastRadiusGridRow">
                                            <Border Background="{Binding RiskBadgeBackground}"
                                                    CornerRadius="3"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RiskText}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding RiskBadgeForeground}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Form UI Impattate -->
                                <DataGridTextColumn Header="Form Impattate"
                                                    Binding="{Binding AffectedFormsCount}"
                                                    Width="110" />

                                <!-- Totale Entità Impattate -->
                                <DataGridTextColumn Header="Tot. Impatto"
                                                    Binding="{Binding TotalImpactedCount}"
                                                    Width="95" />

                                <!-- Azione Rapida -->
                                <DataGridTemplateColumn Header="Azione" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="models:BlastRadiusGridRow">
                                            <Button FontSize="10"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="{Binding ActionButtonTooltip}"
                                                    Click="OnShowInGraphButtonClicked">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <PathIcon Data="{StaticResource IconTarget}" Width="10" Height="10" Foreground="#4AE8D0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ActionButtonText}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Splitter Ridimensionamento Pannello Destro -->
            <GridSplitter x:Name="RightGridSplitter" Grid.Column="3"
                          Width="4"
                          Background="{DynamicResource ThemeBorderDefaultBrush}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWestEast" />

            <!-- Pannello Destro: Symbol Inspector & Impact Analysis -->
            <Border x:Name="InspectorBorder" Grid.Column="4"
                    Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                    BorderThickness="0" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <!-- Intestazione Inspector -->
                        <Grid Margin="4,4,4,8">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconInspect}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="InspectorTitleText" Text="Symbol Inspector &amp; Blast Radius" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>                                
                        </Grid>

                        <!-- Messaggio Nodo Non Selezionato -->
                        <StackPanel x:Name="InspectorEmptyPanel" Spacing="6" Margin="4,8">
                            <TextBlock x:Name="InspectorEmptyTitle" Text="Nessun simbolo selezionato." Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontWeight="Medium" />
                            <TextBlock x:Name="InspectorEmptyHint1" Text="• Clicca su un nodo per visualizzare dettagli semantici, tipi, parametri e chiamate." Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock x:Name="InspectorEmptyHint2" Text="• Clicca su 'Blast Radius' per calcolare il raggio di impatto e il rischio di regressione." Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock x:Name="InspectorEmptyHint3" Text="• Doppio clic su una Classe, Form o Modulo per espandere/comprimere i membri." Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Dettagli Simbolo Selezionato -->
                        <StackPanel x:Name="InspectorDetailsPanel" Spacing="8" IsVisible="False">
                            <!-- Nome -->
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="InspectorSecSymbol" Text="SIMBOLO" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="InspectorName" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource ThemeTextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="InspectorQualifiedName" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Kind & Visibilità -->
                            <Grid ColumnDefinitions="*,*" Margin="0,4">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock x:Name="InspectorSecKind" Text="CATEGORIA" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="InspectorKind" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock x:Name="InspectorSecVisibility" Text="VISIBILITÀ" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="InspectorAccessibility" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Tipo Dichiarato & Risolto -->
                            <StackPanel x:Name="InspectorTypeSection" Spacing="2" Margin="0,2">
                                <TextBlock x:Name="InspectorSecType" Text="TIPO" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="InspectorType" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="12" />
                            </StackPanel>

                            <!-- Parametri Routine -->
                            <StackPanel x:Name="InspectorParamsSection" Spacing="3" Margin="0,2">
                                <TextBlock x:Name="InspectorSecParams" Text="PARAMETRI FORMALI" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="InspectorParams" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" FontFamily="Consolas, monospace" />
                            </StackPanel>

                            <!-- File e Righe -->
                            <StackPanel x:Name="InspectorFileSection" Spacing="2" Margin="0,2">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Grid.Column="0" x:Name="InspectorSecFile" Text="FILE &amp; RIGHE" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" x:Name="InspectorOpenFileButton"
                                            Background="Transparent" BorderThickness="0" Padding="3,1" Margin="2,0"
                                            ToolTip.Tip="Apri file originale"
                                            Click="OnInspectorOpenFileClicked">
                                        <PathIcon Data="{StaticResource IconExport}" Width="11" Height="11" Foreground="{DynamicResource ThemeAccentBrush}" />
                                    </Button>
                                    <Button Grid.Column="2" x:Name="InspectorOpenFolderButton"
                                            Background="Transparent" BorderThickness="0" Padding="3,1" Margin="2,0"
                                            ToolTip.Tip="Mostra nella cartella"
                                            Click="OnInspectorOpenFolderClicked">
                                        <PathIcon Data="{StaticResource IconFolder}" Width="11" Height="11" Foreground="#D4A72C" />
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="InspectorFile" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11" />
                            </StackPanel>

                            <Rectangle Height="1" Fill="{DynamicResource ThemeBorderDefaultBrush}" Margin="0,6" />

                            <!-- Sezione AI Context / LLM Slice -->
                            <Border x:Name="AiContextCardBorder"
                                    Background="{DynamicResource ThemeBackgroundElevatedBrush}"
                                    BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="InspectorSecAiContext" Text="AI CONTEXT / LLM SLICE" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                       
                                    </Grid>
                                    <TextBlock x:Name="InspectorAiContextDesc" Text="Estrae il subgrafo di questo simbolo ottimizzato per prompt AI." Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,*" Margin="0,4">
                                        <Button Grid.Column="0" x:Name="CopyLlmSliceButton"
                                                Margin="0,0,4,0" Padding="8,5"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                ToolTip.Tip="Copia negli appunti il context slice per Antigravity/ChatGPT">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="{StaticResource IconCopy}" Width="11" Height="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="CopyLlmSliceButtonText" Text="Copia Slice" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" x:Name="SaveLlmSliceButton"
                                                Margin="4,0,0,0" Padding="8,5"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                ToolTip.Tip="Salva il subgrafo del simbolo come file .md">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="{StaticResource IconMarkdown}" Width="11" Height="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="SaveLlmSliceButtonText" Text="Salva (.md)" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Rectangle Height="1" Fill="{DynamicResource ThemeBorderDefaultBrush}" Margin="0,6" />

                            <!-- Sezione Impact Analysis & Blast Radius (M6) -->
                            <Border x:Name="BlastRadiusCardBorder"
                                    Background="{DynamicResource ThemeBackgroundElevatedBrush}"
                                    BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="InspectorSecBlast" Text="BLAST RADIUS (IMPACT)" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" x:Name="RiskBadge" CornerRadius="4" Padding="6,2" Background="#2E7D32">
                                            <TextBlock x:Name="RiskLevelText" Text="RISK: LOW" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Border>
                                    </Grid>

                                    <!-- Metriche di Impatto -->
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4">
                                        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="InspectorLabelDirectCallers" Text="Chiamanti Diretti:" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BlastDirectCallersCount" Text="0" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" x:Name="InspectorLabelIndirectCallers" Text="Chiamanti Indiretti:" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BlastIndirectCallersCount" Text="0" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" x:Name="InspectorLabelMaxDepth" Text="Profondità Max (Depth):" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BlastMaxDepth" Text="0" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </Grid>

                                    <!-- Form UI Impattate -->
                                    <StackPanel x:Name="BlastFormsSection" Spacing="2" Margin="0,2">
                                        <TextBlock x:Name="InspectorSecForms" Text="FORM UI IMPATTATE" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock x:Name="BlastFormsList" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" />
                                    </StackPanel>

                                    <!-- Classi & Moduli Impattati -->
                                    <StackPanel x:Name="BlastClassesSection" Spacing="2" Margin="0,2">
                                        <TextBlock x:Name="InspectorSecClasses" Text="CLASSI &amp; MODULI TOCCATI" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock x:Name="BlastClassesList" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" />
                                    </StackPanel>

                                    <!-- Percorsi di Esecuzione a Rischio -->
                                    <StackPanel x:Name="BlastPathsSection" Spacing="2" Margin="0,2">
                                        <TextBlock x:Name="InspectorSecPaths" Text="PERCORSI DI ESECUZIONE (CALL CHAINS)" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock x:Name="BlastPathsList" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="10" FontFamily="Consolas, monospace" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Rectangle Height="1" Fill="{DynamicResource ThemeBorderDefaultBrush}" Margin="0,6" />

                            <!-- Chiamanti Diretti (Callers) -->
                            <StackPanel Spacing="3">
                                <TextBlock x:Name="InspectorSecCallers" Text="CHIAMANTI DIRETTI (WHO CALLS ME?)" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="InspectorCallers" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" />
                            </StackPanel>

                            <!-- Chiamati Diretti (Callees) -->
                            <StackPanel Spacing="3" Margin="0,4">
                                <TextBlock x:Name="InspectorSecCallees" Text="CHIAMATE EFFETTUATE (WHAT DO I CALL?)" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="InspectorCallees" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" />
                            </StackPanel>

                            <!-- Istanziazioni -->
                            <StackPanel x:Name="InspectorInstantiatesSection" Spacing="3" Margin="0,4">
                                <TextBlock x:Name="InspectorSecInstantiates" Text="CLASSI ISTANZIATE (NEW)" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="InspectorInstantiates" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Barra di Stato Inferiore -->
        <Border x:Name="StatusBarBorder" Grid.Row="3" Background="{DynamicResource ThemeBackgroundSecondaryBrush}" Padding="12,5" BorderBrush="{DynamicResource ThemeBorderDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" x:Name="StatusText" Text="Pronto." Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" x:Name="StatusStats" Text="Nodi: 0 | Relazioni: 0" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Overlay di Caricamento Centrato a Schermo (Blast Radius & Analisi Asincrona) -->
        <Grid x:Name="LoadingOverlay" Grid.Row="0" Grid.RowSpan="4"
              Background="#75101018"
              IsVisible="False"
              ZIndex="999">
            <Border Background="{DynamicResource ThemeBackgroundElevatedBrush}"
                    BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 32 0 #80000000">
                <Border.Styles>
                    <Style Selector="Path.spinner">
                        <Style.Animations>
                            <Animation Duration="0:0:1" IterationCount="Infinite">
                                <KeyFrame Cue="0%">
                                    <Setter Property="RotateTransform.Angle" Value="0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="RotateTransform.Angle" Value="360"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Border.Styles>
                <StackPanel Spacing="14" HorizontalAlignment="Center" Width="340">
                    <!-- Icona Spinner Rotante -->
                    <Panel Width="44" Height="44" HorizontalAlignment="Center">
                        <Ellipse Width="44" Height="44" Stroke="{DynamicResource ThemeBorderDefaultBrush}" StrokeThickness="3.5" />
                        <Path Classes="spinner"
                              Width="44" Height="44"
                              Stroke="{DynamicResource ThemeAccentBrush}" StrokeThickness="3.5"
                              StrokeLineCap="Round"
                              Data="M 22 4 A 18 18 0 0 1 40 22"
                              RenderTransformOrigin="50%,50%">
                            <Path.RenderTransform>
                                <RotateTransform />
                            </Path.RenderTransform>
                        </Path>
                    </Panel>

                    <!-- Titolo e Sottotitolo -->
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock x:Name="LoadingTitle"
                                   Text="Calcolo Blast Radius in corso..."
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="LoadingSubtitle"
                                   Text="Esplorazione chiamanti e percorsi di chiamata..."
                                   FontSize="11"
                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Barra di Avanzamento con Dettagli File/Nodi -->
                    <StackPanel Spacing="6">
                        <ProgressBar x:Name="LoadingProgressBar"
                                     IsIndeterminate="True"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Foreground="{DynamicResource ThemeAccentBrush}"
                                     Background="{DynamicResource ThemeBorderDefaultBrush}"
                                     CornerRadius="3"
                                     Margin="0,2,0,0" />
                        <Grid ColumnDefinitions="*,Auto" Margin="2,0">
                            <TextBlock x:Name="LoadingProgressCount"
                                       Grid.Column="0"
                                       Text="0 / 0 file analizzati"
                                       FontSize="11"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                       HorizontalAlignment="Left"
                                       IsVisible="False" />
                            <TextBlock x:Name="LoadingProgressStats"
                                       Grid.Column="1"
                                       Text="0 nodi rilevati"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource ThemeAccentBrush}"
                                       HorizontalAlignment="Right"
                                       IsVisible="False" />
                        </Grid>
                    </StackPanel>

                    <!-- Pulsante Annulla Analisi -->
                    <Button x:Name="LoadingCancelButton"
                            Content="Annulla"
                            Click="LoadingCancelButton_Click"
                            HorizontalAlignment="Center"
                            Padding="22,6"
                            Margin="0,6,0,0"
                            Background="Transparent"
                            Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                            BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            FontSize="12"
                            Cursor="Hand" />
                </StackPanel>
            </Border>
        </Grid>



        <!-- Overlay Modale Aggiornamento Disponibile -->
        <Grid x:Name="UpdateOverlay" Grid.Row="0" Grid.RowSpan="4"
              Background="#75101018"
              IsVisible="False"
              ZIndex="998">
            <Border Background="{DynamicResource ThemeBackgroundElevatedBrush}"
                    BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="28,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="480"
                    MinWidth="380"
                    BoxShadow="0 12 36 0 #80000000">
                <StackPanel Spacing="16">
                    <!-- Header con Icona e Titoli -->
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8" Background="{DynamicResource ThemeAccentBrush}" Opacity="0.15" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <PathIcon Grid.Column="0" Data="{StaticResource IconUpdate}" Width="20" Height="20" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="UpdateModalTitle" Text="Nuovo Aggiornamento Disponibile!" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                            <TextBlock x:Name="UpdateModalSubtitle" Text="Versione 1.1.0 disponibile (attuale: 1.0.0)" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Release Notes / Descrizione Novità -->
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="UpdateModalNotesLabel" Text="Novità e Note di Rilascio:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                        <Border Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                MaxHeight="140">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="UpdateModalNotes"
                                           Text="Miglioramenti di stabilità e nuove funzionalità..."
                                           FontSize="12"
                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <!-- Pulsanti di Azione: Scarica dopo / Aggiorna -->
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                        <Button x:Name="UpdateLaterButton"
                                Grid.Column="1"
                                Content="Scarica dopo"
                                Padding="16,8"
                                Background="Transparent"
                                Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                FontSize="12"
                                Margin="0,0,8,0" />
                        <Button x:Name="UpdateNowButton"
                                Grid.Column="2"
                                Content="Aggiorna ora"
                                Padding="18,8"
                                Background="{DynamicResource ThemeAccentBrush}"
                                Foreground="#FFFFFF"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                CornerRadius="4"
                                FontSize="12" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
