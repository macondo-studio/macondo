<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:VB6Analyzer.App.Controls"
        xmlns:models="using:VB6Analyzer.App.Models"
        x:Class="VB6Analyzer.App.MainWindow"
        Title="VB6 Semantic Code Analyzer"
        Width="1400" Height="900"
        Background="#181820"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="{Binding $parent[Window].OffScreenMargin}">

        <!-- Barra Superiore Stile IDE (Brand & Menu a Sinistra | Area Trascinamento al Centro | Controlli Finestra a Destra) -->
        <Border Grid.Row="0" Background="#14141D" BorderBrush="#2D2D3E" BorderThickness="0,0,0,1" Padding="8,0,0,0" Height="36">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Sinistra: Brand / Logo App + Menu a Discesa -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,16,0" Spacing="6">
                        <PathIcon Data="{StaticResource IconAppLogo}" Width="12" Height="12" Foreground="#FF6633" VerticalAlignment="Center" />
                        <TextBlock Text="VB6 Analyzer" FontWeight="SemiBold" FontSize="12" Foreground="#8A8A9E" VerticalAlignment="Center" />
                    </StackPanel>

                    <Menu Background="Transparent">
                        <MenuItem Header="_File">
                            <MenuItem x:Name="OpenFolderMenuItem" Header="Apri Cartella VB6..." InputGesture="Ctrl+O">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="LoadFixturesMenuItem" Header="Carica Fixtures Test">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconBeaker}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="GenerateFakeMenuItem" Header="Grafo Demo (~500 nodi)">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconZap}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="ExitMenuItem" Header="Esci" InputGesture="Alt+F4">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconExit}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="_Visualizza">
                            <MenuItem x:Name="ResetViewMenuItem" Header="Reset Vista">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconTarget}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ExpandAllMenuItem" Header="Espandi Tutto">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconExpandAll}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="CollapseAllMenuItem" Header="Comprimi Tutto">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconCollapseAll}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="_Analisi">
                            <MenuItem x:Name="BlastRadiusMenuItem" Header="Calcola Blast Radius" InputGesture="F5">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconBlastRadius}" Width="14" Height="14" Foreground="#FF6633" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ShowCallersMenuItem" Header="Mostra Callers">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconCallers}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ShowCalleesMenuItem" Header="Mostra Callees">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconCallees}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="ClearHighlightMenuItem" Header="Pulisci Filtri">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource IconClearFilter}" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <!-- Centro: Area di Trascinamento Finestra e Doppio Click per Massimizzare -->
                <Border Grid.Column="1" Background="Transparent"
                        PointerPressed="OnTitleBarPointerPressed"
                        DoubleTapped="OnTitleBarDoubleTapped" />

                <!-- Destra: Pulsanti di Controllo Finestra (Riduci a icona, Ingrandisci, Chiudi) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <StackPanel.Styles>
                        <Style Selector="Button.caption-btn">
                            <Setter Property="Width" Value="46" />
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="CornerRadius" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Foreground" Value="#A0A0B8" />
                        </Style>
                        <Style Selector="Button.caption-btn:pointerover">
                            <Setter Property="Background" Value="#2D2D3E" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Style>
                        <Style Selector="Button.caption-close:pointerover">
                            <Setter Property="Background" Value="#E81123" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Style>
                    </StackPanel.Styles>

                    <Button x:Name="MinimizeButton" Classes="caption-btn" ToolTip.Tip="Riduci a icona">
                        <PathIcon Data="{StaticResource IconWindowMinimize}" Width="10" Height="10" />
                    </Button>
                    <Button x:Name="MaximizeButton" Classes="caption-btn" ToolTip.Tip="Ingrandisci / Ripristina">
                        <PathIcon x:Name="MaximizeIcon" Data="{StaticResource IconWindowMaximize}" Width="10" Height="10" />
                    </Button>
                    <Button x:Name="CloseButton" Classes="caption-btn caption-close" ToolTip.Tip="Chiudi">
                        <PathIcon Data="{StaticResource IconWindowClose}" Width="10" Height="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barra Secondaria: Casella di Ricerca Dedicata con Hint Ctrl + F -->
        <Border Grid.Row="1" Background="#181822" BorderBrush="#2A2A38" BorderThickness="0,0,0,1" Padding="10,6">
            <Panel HorizontalAlignment="Center">
                <TextBox x:Name="SearchBox"
                         Width="440"
                         Watermark="Cerca simbolo nel grafo..."
                         TextChanged="OnSearchTextChanged"
                         KeyDown="OnSearchBoxKeyDown">
                    <TextBox.InnerLeftContent>
                        <PathIcon Data="{StaticResource IconSearch}" Width="13" Height="13" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="#7A7A90" />
                    </TextBox.InnerLeftContent>
                    <TextBox.InnerRightContent>
                        <Border Background="#252535"
                                BorderBrush="#3D3D52"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="Ctrl + F"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#8A8AA0"
                                       VerticalAlignment="Center" />
                        </Border>
                    </TextBox.InnerRightContent>
                </TextBox>

                <!-- Dropdown Risultati Multipli -->
                <Popup x:Name="SearchResultsPopup"
                       PlacementTarget="{Binding ElementName=SearchBox}"
                       Placement="Bottom"
                       IsLightDismissEnabled="True"
                       VerticalOffset="4">
                    <Border Background="#1E1E28"
                            BorderBrush="#3D3D52"
                            BorderThickness="1"
                            CornerRadius="6"
                            BoxShadow="0 8 24 0 #90000000"
                            MinWidth="360"
                            MaxWidth="500"
                            MaxHeight="320"
                            Padding="6">
                        <DockPanel>
                            <TextBlock x:Name="SearchResultsHeader"
                                       DockPanel.Dock="Top"
                                       Text="Risultati trovati:"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#9090A0"
                                       Margin="6,4,6,6" />
                            <ListBox x:Name="SearchResultsList"
                                     Background="Transparent"
                                     SelectionChanged="OnSearchResultSelected"
                                     KeyDown="OnSearchResultsListKeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="models:GraphNode">
                                        <Grid ColumnDefinitions="Auto,*" Margin="2">
                                            <Border Grid.Column="0"
                                                    Background="#28283C"
                                                    BorderBrush="#3D3D55"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="4,1"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="SemiBold" Foreground="#4AE8D0" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="#ECECF0" />
                                                <TextBlock Text="{Binding QualifiedName}" FontSize="10" Foreground="#8A8A9C" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Popup>
            </Panel>
        </Border>

        <!-- Area Centrale: Explorer | Graph + Floating Actions | Inspector -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="360" MinWidth="240" MaxWidth="800" />
            </Grid.ColumnDefinitions>

            <!-- Pannello Sinistro: Project Explorer -->
            <Border Grid.Column="0" Background="#1E1E28" BorderBrush="#353545" BorderThickness="0,0,1,0" Padding="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="4,4,4,8">
                        <PathIcon Data="{StaticResource IconFolder}" Width="13" Height="13" Foreground="#FF6633" VerticalAlignment="Center" />
                        <TextBlock Text="Project Explorer" FontWeight="Bold" FontSize="13" Foreground="#ECECF0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TreeView x:Name="ExplorerTree" SelectionChanged="OnExplorerSelectionChanged">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate DataType="models:ExplorerTreeItem" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                                    <Border Background="{Binding BadgeBackground}"
                                            CornerRadius="3"
                                            Padding="4,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KindBadge}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding BadgeForeground}" />
                                    </Border>
                                    <TextBlock Text="{Binding DisplayText}" FontSize="12" Foreground="#ECECF0" VerticalAlignment="Center" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Pannello Centrale con Tab (Vista Grafo / Griglia Blast Radius) -->
            <TabControl Grid.Column="1" x:Name="CentralTabControl" SelectedIndex="0" Padding="0">
                <TabControl.Styles>
                    <Style Selector="TabItem">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="16,8" />
                        <Setter Property="Foreground" Value="#8A8A9E" />
                    </Style>
                    <Style Selector="TabItem:selected">
                        <Setter Property="Foreground" Value="#FF6633" />
                    </Style>
                </TabControl.Styles>

                <!-- TAB 1: Canvas Interattivo del Grafo con Floating HUD -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconGraph}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock Text="Vista Grafo" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <!-- Canvas del Grafo -->
                        <controls:GraphControl x:Name="Graph" SelectionChanged="OnGraphSelectionChanged" />

                        <!-- Pannello Flottante Verticale Comandi Grafo (In alto a destra, Icona + Testo) -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="16"
                                Background="#1C1C28F0"
                                BorderBrush="#3D3D52"
                                BorderThickness="1"
                                CornerRadius="8"
                                BoxShadow="0 6 24 0 #90000000"
                                Padding="5">
                            <Border.Styles>
                                <Style Selector="Button">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    <Setter Property="Padding" Value="10,6" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                </Style>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#2D2D40" />
                                    <Setter Property="BorderBrush" Value="#464660" />
                                </Style>
                            </Border.Styles>
                            <StackPanel Width="138">
                                <!-- Gruppo Vista e Navigazione -->
                                <Button x:Name="ResetViewButton" ToolTip.Tip="Ripristina zoom 100% e centra la visuale">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconTarget}" Width="13" Height="13" Foreground="#4AE8D0" VerticalAlignment="Center" />
                                        <TextBlock Text="Reset Vista" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ExpandAllButton" ToolTip.Tip="Espande tutti i moduli mostrando metodi e proprietà">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconExpandAll}" Width="13" Height="13" Foreground="#A0A0B8" VerticalAlignment="Center" />
                                        <TextBlock Text="Espandi Tutto" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CollapseAllButton" ToolTip.Tip="Comprime tutti i moduli nascondendo i membri interni">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconCollapseAll}" Width="13" Height="13" Foreground="#A0A0B8" VerticalAlignment="Center" />
                                        <TextBlock Text="Comprimi Tutto" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Separatore Sottile -->
                                <Rectangle Height="1" Fill="#323246" Margin="4,4" />

                                <!-- Gruppo Ispezione e Blast Radius -->
                                <Button x:Name="BlastRadiusButton" ToolTip.Tip="Calcola ed evidenzia l'impatto di modifica (chiamanti indiretti, form e classi impattate)">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconBlastRadius}" Width="13" Height="13" Foreground="#FF6633" VerticalAlignment="Center" />
                                        <TextBlock Text="Blast Radius" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ShowCallersButton" ToolTip.Tip="Evidenzia chi chiama la routine selezionata">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconCallers}" Width="13" Height="13" Foreground="#50E3C2" VerticalAlignment="Center" />
                                        <TextBlock Text="Mostra Callers" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ShowCalleesButton" ToolTip.Tip="Evidenzia cosa chiama la routine selezionata">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconCallees}" Width="13" Height="13" Foreground="#61AFEF" VerticalAlignment="Center" />
                                        <TextBlock Text="Mostra Callees" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ClearHighlightButton" ToolTip.Tip="Rimuove le evidenziazioni attive">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconClearFilter}" Width="13" Height="13" Foreground="#E06C75" VerticalAlignment="Center" />
                                        <TextBlock Text="Pulisci Filtri" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 2: Griglia Risultati Blast Radius & Matrice di Rischio -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconTable}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock Text="Griglia Blast Radius" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid RowDefinitions="Auto,*">
                        <!-- Toolbar della Griglia: Filtri e Statistiche -->
                        <Border Grid.Row="0" Background="#20202C" BorderBrush="#353545" BorderThickness="0,0,0,1" Padding="12,8">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                <!-- Filtro Testo nella Tabella -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Filtra:" VerticalAlignment="Center" FontSize="11" Foreground="#8A8A9E" />
                                    <TextBox x:Name="GridFilterTextBox"
                                             Width="180"
                                             Watermark="Nome routine o modulo..."
                                             FontSize="11"
                                             TextChanged="OnGridFilterTextChanged" />
                                </StackPanel>

                                <!-- Filtro Livello di Rischio -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <TextBlock Text="Rischio:" VerticalAlignment="Center" FontSize="11" Foreground="#8A8A9E" />
                                    <ComboBox x:Name="RiskFilterComboBox" SelectedIndex="0" FontSize="11" Width="130" SelectionChanged="OnRiskFilterChanged">
                                        <ComboBoxItem Content="Tutti i Livelli" />
                                        <ComboBoxItem Content="Critical" />
                                        <ComboBoxItem Content="High" />
                                        <ComboBoxItem Content="Medium" />
                                        <ComboBoxItem Content="Low" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- Contatore Riassuntivo -->
                                <TextBlock Grid.Column="2" x:Name="GridStatsTextBlock"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           FontSize="11"
                                           Foreground="#8A8A9E"
                                           Margin="0,0,16,0" />

                                <!-- Pulsante Aggiorna / Ricalcola Audit -->
                                <Button Grid.Column="3" x:Name="RefreshGridButton"
                                        FontSize="11"
                                        Padding="10,5"
                                        ToolTip.Tip="Ricalcola la matrice di rischio e impatto per tutte le routine"
                                        Click="OnRefreshGridClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconRefresh}" Width="11" Height="11" Foreground="#4AE8D0" VerticalAlignment="Center" />
                                        <TextBlock Text="Ricalcola Audit" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Tabella Risultati Blast Radius (DataGrid) -->
                        <DataGrid Grid.Row="1" x:Name="BlastRadiusDataGrid"
                                  x:DataType="models:BlastRadiusGridRow"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  CanUserResizeColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  Background="#161620"
                                  RowBackground="#181824"
                                  SelectionMode="Single"
                                  SelectionChanged="OnGridRowSelectionChanged"
                                  DoubleTapped="OnGridRowDoubleTapped">
                            <DataGrid.Columns>
                                <!-- Simbolo / Routine -->
                                <DataGridTextColumn Header="Routine / Simbolo"
                                                    Binding="{Binding Name}"
                                                    Width="2*" />

                                <!-- Modulo / Container -->
                                <DataGridTextColumn Header="Modulo / Container"
                                                    Binding="{Binding ContainerName}"
                                                    Width="1.5*" />

                                <!-- Chiamanti Diretti -->
                                <DataGridTextColumn Header="Chiamanti Diretti"
                                                    Binding="{Binding DirectCallersCount}"
                                                    Width="120" />

                                <!-- Chiamanti Indiretti -->
                                <DataGridTextColumn Header="Chiamanti Indiretti"
                                                    Binding="{Binding IndirectCallersCount}"
                                                    Width="130" />

                                <!-- Profondità Max -->
                                <DataGridTextColumn Header="Profondità"
                                                    Binding="{Binding MaxDepth}"
                                                    Width="90" />

                                <!-- Livello di Rischio (Badge Colorato) -->
                                <DataGridTemplateColumn Header="Rischio" Width="100" SortMemberPath="RiskLevel">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="models:BlastRadiusGridRow">
                                            <Border Background="{Binding RiskBadgeBackground}"
                                                    CornerRadius="3"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RiskText}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding RiskBadgeForeground}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Form UI Impattate -->
                                <DataGridTextColumn Header="Form Impattate"
                                                    Binding="{Binding AffectedFormsCount}"
                                                    Width="110" />

                                <!-- Totale Entità Impattate -->
                                <DataGridTextColumn Header="Tot. Impatto"
                                                    Binding="{Binding TotalImpactedCount}"
                                                    Width="95" />

                                <!-- Azione Rapida -->
                                <DataGridTemplateColumn Header="Azione" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="models:BlastRadiusGridRow">
                                            <Button FontSize="10"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Click="OnShowInGraphButtonClicked">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <PathIcon Data="{StaticResource IconTarget}" Width="10" Height="10" Foreground="#4AE8D0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Mostra Grafo" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Splitter Ridimensionamento Pannello Destro -->
            <GridSplitter Grid.Column="2"
                          Width="4"
                          Background="#2A2A38"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWestEast" />

            <!-- Pannello Destro: Symbol Inspector & Impact Analysis -->
            <Border Grid.Column="3" Background="#1E1E28" BorderBrush="#353545" BorderThickness="1,0,0,0" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <!-- Intestazione Inspector -->
                        <Border Padding="8,6" Background="#262632" CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconInspect}" Width="13" Height="13" Foreground="#FF6633" VerticalAlignment="Center" />
                                <TextBlock Text="Symbol Inspector &amp; Blast Radius" FontWeight="SemiBold" FontSize="13" Foreground="#ECECF0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Messaggio Nodo Non Selezionato -->
                        <StackPanel x:Name="InspectorEmptyPanel" Spacing="6" Margin="4,8">
                            <TextBlock Text="Nessun simbolo selezionato." Foreground="#9090A0" FontWeight="Medium" />
                            <TextBlock Text="• Clicca su un nodo per visualizzare dettagli semantici, tipi, parametri e chiamate." Foreground="#707080" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="• Clicca su 'Blast Radius' per calcolare il raggio di impatto e il rischio di regressione." Foreground="#707080" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="• Doppio clic su una Classe, Form o Modulo per espandere/comprimere i membri." Foreground="#707080" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Dettagli Simbolo Selezionato -->
                        <StackPanel x:Name="InspectorDetailsPanel" Spacing="8" IsVisible="False">
                            <!-- Nome -->
                            <StackPanel Spacing="2">
                                <TextBlock Text="SIMBOLO" Foreground="#707080" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="InspectorName" FontWeight="Bold" FontSize="15" Foreground="#FFD700" TextWrapping="Wrap" />
                                <TextBlock x:Name="InspectorQualifiedName" Foreground="#A0A0B0" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Kind & Visibilità -->
                            <Grid ColumnDefinitions="*,*" Margin="0,4">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="CATEGORIA" Foreground="#707080" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="InspectorKind" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="VISIBILITÀ" Foreground="#707080" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="InspectorAccessibility" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                </StackPanel>
                            </Grid>

                            <!-- Tipo Dichiarato & Risolto -->
                            <StackPanel x:Name="InspectorTypeSection" Spacing="2" Margin="0,2">
                                <TextBlock Text="TIPO" Foreground="#707080" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="InspectorType" TextWrapping="Wrap" Foreground="#4AE8D0" FontSize="12" />
                            </StackPanel>

                            <!-- Parametri Routine -->
                            <StackPanel x:Name="InspectorParamsSection" Spacing="3" Margin="0,2">
                                <TextBlock Text="PARAMETRI FORMALI" Foreground="#707080" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="InspectorParams" TextWrapping="Wrap" Foreground="#ECECF0" FontSize="11" FontFamily="Consolas, monospace" />
                            </StackPanel>

                            <!-- File e Righe -->
                            <StackPanel x:Name="InspectorFileSection" Spacing="2" Margin="0,2">
                                <TextBlock Text="FILE &amp; RIGHE" Foreground="#707080" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="InspectorFile" TextWrapping="Wrap" Foreground="#A0A0B0" FontSize="11" />
                            </StackPanel>

                            <Rectangle Height="1" Fill="#353545" Margin="0,6" />

                            <!-- Sezione Impact Analysis & Blast Radius (M6) -->
                            <Border Background="#242432" BorderBrush="#3D3D52" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="BLAST RADIUS (IMPACT)" Foreground="#FF6633" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" x:Name="RiskBadge" CornerRadius="4" Padding="6,2" Background="#2E7D32">
                                            <TextBlock x:Name="RiskLevelText" Text="RISK: LOW" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Border>
                                    </Grid>

                                    <!-- Metriche di Impatto -->
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Chiamanti Diretti:" Foreground="#A0A0B0" FontSize="11" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BlastDirectCallersCount" Text="0" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Chiamanti Indiretti:" Foreground="#A0A0B0" FontSize="11" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BlastIndirectCallersCount" Text="0" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Profondità Max (Depth):" Foreground="#A0A0B0" FontSize="11" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BlastMaxDepth" Text="0" Foreground="#FFCC00" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </Grid>

                                    <!-- Form UI Impattate -->
                                    <StackPanel x:Name="BlastFormsSection" Spacing="2" Margin="0,2">
                                        <TextBlock Text="FORM UI IMPATTATE" Foreground="#00D0FF" FontSize="10" FontWeight="Bold" />
                                        <TextBlock x:Name="BlastFormsList" TextWrapping="Wrap" Foreground="#ECECF0" FontSize="11" />
                                    </StackPanel>

                                    <!-- Classi & Moduli Impattati -->
                                    <StackPanel x:Name="BlastClassesSection" Spacing="2" Margin="0,2">
                                        <TextBlock Text="CLASSI &amp; MODULI TOCCATI" Foreground="#54C08C" FontSize="10" FontWeight="Bold" />
                                        <TextBlock x:Name="BlastClassesList" TextWrapping="Wrap" Foreground="#ECECF0" FontSize="11" />
                                    </StackPanel>

                                    <!-- Percorsi di Esecuzione a Rischio -->
                                    <StackPanel x:Name="BlastPathsSection" Spacing="2" Margin="0,2">
                                        <TextBlock Text="PERCORSI DI ESECUZIONE (CALL CHAINS)" Foreground="#FFCC00" FontSize="10" FontWeight="Bold" />
                                        <TextBlock x:Name="BlastPathsList" TextWrapping="Wrap" Foreground="#ECECF0" FontSize="10" FontFamily="Consolas, monospace" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Rectangle Height="1" Fill="#353545" Margin="0,6" />

                            <!-- Chiamanti Diretti (Callers) -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="CHIAMANTI DIRETTI (WHO CALLS ME?)" Foreground="#FF9933" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="InspectorCallers" TextWrapping="Wrap" Foreground="#ECECF0" FontSize="11" />
                            </StackPanel>

                            <!-- Chiamati Diretti (Callees) -->
                            <StackPanel Spacing="3" Margin="0,4">
                                <TextBlock Text="CHIAMATE EFFETTUATE (WHAT DO I CALL?)" Foreground="#33CCFF" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="InspectorCallees" TextWrapping="Wrap" Foreground="#ECECF0" FontSize="11" />
                            </StackPanel>

                            <!-- Istanziazioni -->
                            <StackPanel x:Name="InspectorInstantiatesSection" Spacing="3" Margin="0,4">
                                <TextBlock Text="CLASSI ISTANZIATE (NEW)" Foreground="#E88C38" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="InspectorInstantiates" TextWrapping="Wrap" Foreground="#ECECF0" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Barra di Stato Inferiore -->
        <Border Grid.Row="3" Background="#16161D" Padding="12,6" BorderBrush="#353545" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" x:Name="StatusText" Text="Pronto." Foreground="#808090" FontSize="11" />
                <TextBlock Grid.Column="1" x:Name="StatusStats" Text="Nodi: 0 | Relazioni: 0" Foreground="#606070" FontSize="11" />
            </Grid>
        </Border>

        <!-- Overlay di Caricamento Centrato a Schermo (Blast Radius & Analisi Asincrona) -->
        <Grid x:Name="LoadingOverlay" Grid.Row="0" Grid.RowSpan="4"
              Background="#75101018"
              IsVisible="False"
              ZIndex="999">
            <Border Background="#22222E"
                    BorderBrush="#3D3D52"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 32 0 #80000000">
                <Border.Styles>
                    <Style Selector="Path.spinner">
                        <Style.Animations>
                            <Animation Duration="0:0:1" IterationCount="Infinite">
                                <KeyFrame Cue="0%">
                                    <Setter Property="RotateTransform.Angle" Value="0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="RotateTransform.Angle" Value="360"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Border.Styles>
                <StackPanel Spacing="14" HorizontalAlignment="Center" Width="280">
                    <!-- Icona Spinner Rotante -->
                    <Panel Width="44" Height="44" HorizontalAlignment="Center">
                        <Ellipse Width="44" Height="44" Stroke="#353545" StrokeThickness="3.5" />
                        <Path Classes="spinner"
                              Width="44" Height="44"
                              Stroke="#FF6633" StrokeThickness="3.5"
                              StrokeLineCap="Round"
                              Data="M 22 4 A 18 18 0 0 1 40 22"
                              RenderTransformOrigin="50%,50%">
                            <Path.RenderTransform>
                                <RotateTransform />
                            </Path.RenderTransform>
                        </Path>
                    </Panel>

                    <!-- Titolo e Sottotitolo -->
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock x:Name="LoadingTitle"
                                   Text="Calcolo Blast Radius in corso..."
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#ECECF0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="LoadingSubtitle"
                                   Text="Esplorazione chiamanti e percorsi di chiamata..."
                                   FontSize="11"
                                   Foreground="#A0A0B0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Barra Indeterminata Fluida -->
                    <ProgressBar IsIndeterminate="True"
                                 Height="4"
                                 Foreground="#FF6633"
                                 Background="#353545"
                                 CornerRadius="2"
                                 Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
