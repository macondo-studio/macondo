<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Macondo.App</RootNamespace>
    <AssemblyName>Macondo</AssemblyName>
    <ApplicationIcon>Assets\Icons\icon1_star_knot.ico</ApplicationIcon>
    <Version>1.5.0</Version>
    <AssemblyVersion>1.5.0.0</AssemblyVersion>
    <FileVersion>1.5.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!--
      NOTA IMPORTANTE: SelfContained / PublishSingleFile / RuntimeIdentifier NON sono
      impostati qui a livello globale, apposta: se lo fossero, 'dotnet build' e
      'dotnet run' in sviluppo si romperebbero (richiedono un RID esplicito).
      Per il packaging "single EXE portable" usare i comandi
      dotnet publish elencati nel README, che passano questi flag solo in fase di publish.
    -->

    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.1.3" />
    <!-- Diagnostics solo in Debug: DevTools (F12) per ispezionare il visual tree -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.1.3" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\VB6ParserSpike\src\VB6Analyzer.Parser\VB6Analyzer.Parser.csproj" />
    <ProjectReference Include="..\..\..\VB6ParserSpike\src\VB6Analyzer.Semantic\VB6Analyzer.Semantic.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <None Include="..\..\..\VB6ParserSpike\src\VB6Analyzer.Semantic.Spike\Fixtures\**\*.*">
      <Link>Fixtures\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
