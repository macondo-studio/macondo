<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:Macondo.App.Models"
        xmlns:services="using:Macondo.App.Services"
        x:Class="Macondo.App.Views.SettingsWindow"
        Title="Impostazioni"
        Icon="avares://Macondo/Assets/Icons/icon1_star_knot.ico"
        Width="780" Height="530"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundPrimaryBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Grid RowDefinitions="36,*" Margin="{Binding $parent[Window].OffScreenMargin}">

        <!-- Barra Superiore Titolo e Chiusura Finestra -->
        <Border x:Name="TopTitleBorder" Grid.Row="0"
                Background="{DynamicResource ThemeBackgroundSecondaryBrush}"
                BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                BorderThickness="0,0,0,1" Padding="12,0,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Titolo Finestra con Icona Ingranaggio -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <PathIcon Data="{StaticResource IconSettings}" Width="13" Height="13" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="WindowTitleText" Text="Impostazioni" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Area Trascinamento -->
                <Border Grid.Column="1" Background="Transparent" PointerPressed="OnTitleBarPointerPressed" />

                <!-- Pulsante Chiudi -->
                <Button Grid.Column="2" x:Name="CloseButton"
                        Width="46" Height="36"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="0"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip.Tip="Chiudi"
                        Click="OnCloseClicked">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#E81123" />
                        </Style>
                        <Style Selector="Button:pointerover PathIcon">
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Style>
                    </Button.Styles>
                    <PathIcon Data="{StaticResource IconWindowClose}" Width="10" Height="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                </Button>
            </Grid>
        </Border>

        <!-- Corpo Principale Impostazioni (Sidebar + Contenuto) -->
        <Grid Grid.Row="1" ColumnDefinitions="210,*">

            <!-- Sidebar Sinistra: Schede Navigazione & Reset -->
            <Border x:Name="SidebarBorder" Grid.Column="0"
                    Background="{DynamicResource ThemeBackgroundSecondaryBrush}"
                    BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                    BorderThickness="0,0,1,0" Padding="8,12">
                <DockPanel LastChildFill="False">
                    <!-- Gruppo Schede Navigazione (In Alto) -->
                    <StackPanel DockPanel.Dock="Top" Spacing="4">
                        <StackPanel.Styles>
                            <Style Selector="Button.nav-btn">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
                            </Style>
                            <Style Selector="Button.nav-btn:pointerover">
                                <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                            </Style>
                            <Style Selector="Button.nav-btn.selected">
                                <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </StackPanel.Styles>

                        <!-- Tab 1: Aspetto & Temi -->
                        <Button x:Name="NavThemeButton" Classes="nav-btn selected" Click="OnNavThemeClicked">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource IconTheme}" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock x:Name="NavThemeText" Text="Aspetto &amp; Temi" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Tab 2: Lingua -->
                        <Button x:Name="NavLanguageButton" Classes="nav-btn" Click="OnNavLanguageClicked">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource IconLanguage}" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock x:Name="NavLanguageText" Text="Lingua" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Tab 3: Comportamento -->
                        <Button x:Name="NavBehaviorButton" Classes="nav-btn" Click="OnNavBehaviorClicked">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource IconGraph}" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock x:Name="NavBehaviorText" Text="Comportamento" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Tab 4: Schede Analitiche -->
                        <Button x:Name="NavAnalyticsTabsButton" Classes="nav-btn" Click="OnNavAnalyticsTabsClicked">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource IconTable}" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock x:Name="NavAnalyticsTabsText" Text="Schede Analitiche" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Tab 5: Scorciatoie -->
                        <Button x:Name="NavShortcutsButton" Classes="nav-btn" Click="OnNavShortcutsClicked">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource IconKeyboard}" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock x:Name="NavShortcutsText" Text="Scorciatoie" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Pulsante Ripristina Impostazioni Predefinite (In Basso) -->
                    <Button DockPanel.Dock="Bottom" x:Name="ResetSettingsButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="10,8"
                            FontSize="11"
                            Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                            CornerRadius="6"
                            Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                            Click="OnResetSettingsClicked">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                            </Style>
                        </Button.Styles>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource IconRefresh}" Width="13" Height="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="ResetSettingsButtonText" Text="Ripristina Predefiniti" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Border>

            <!-- Area Contenuti Destra -->
            <Border x:Name="ContentBorder" Grid.Column="1"
                    Background="{DynamicResource ThemeBackgroundPrimaryBrush}" Padding="24,18">
                <Panel>

                    <!-- SEZIONE 1: ASPETTO E TEMI -->
                    <ScrollViewer x:Name="ThemeSection" IsVisible="True" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="ThemeHeaderTitle" Text="Seleziona Tema Grafico" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                <TextBlock x:Name="ThemeHeaderSub" Text="Scegli la palette visiva per l'interfaccia dell'IDE e per il canvas del grafo." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Griglia dei 4 Temi -->
                            <StackPanel Spacing="10">
                                <!-- Card 1: Dark Modern -->
                                <Border x:Name="CardDarkModern"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Cursor="Hand" PointerPressed="OnSelectDarkModern">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Palette Swatch Preview -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <Border Width="16" Height="32" Background="#181820" CornerRadius="3,0,0,3" BorderBrush="#353545" BorderThickness="1" />
                                            <Border Width="16" Height="32" Background="#1E1E28" BorderBrush="#353545" BorderThickness="1,1,0,1" />
                                            <Border Width="16" Height="32" Background="#10B981" BorderBrush="#353545" BorderThickness="1,1,0,1" />
                                            <Border Width="16" Height="32" Background="#ECECF0" CornerRadius="0,3,3,0" BorderBrush="#353545" BorderThickness="1" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="ThemeDarkModernTitle" Text="Dark Modern (Predefinito)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="ThemeDarkModernDesc" Text="Stile grafite scuro minimale con accenti verde smeraldo." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckDarkModern" Width="22" Height="22" CornerRadius="11" Background="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Card 2: Dark Studio-->
                                <Border x:Name="CardVSDark"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Cursor="Hand" PointerPressed="OnSelectVSDark">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <Border Width="16" Height="32" Background="#1E1E1E" CornerRadius="3,0,0,3" BorderBrush="#353545" BorderThickness="1" />
                                            <Border Width="16" Height="32" Background="#2D2D30" BorderBrush="#353545" BorderThickness="1,1,0,1" />
                                            <Border Width="16" Height="32" Background="#007ACC" BorderBrush="#353545" BorderThickness="1,1,0,1" />
                                            <Border Width="16" Height="32" Background="#F1F1F1" CornerRadius="0,3,3,0" BorderBrush="#353545" BorderThickness="1" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="ThemeVSDarkTitle" Text="Studio Dark" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="ThemeVSDarkDesc" Text="Palette scura classica con accento blu." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckVSDark" Width="22" Height="22" CornerRadius="11" Background="#007ACC" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Card 3: One Dark Pro -->
                                <Border x:Name="CardOneDark"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Cursor="Hand" PointerPressed="OnSelectOneDark">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <Border Width="16" Height="32" Background="#21252B" CornerRadius="3,0,0,3" BorderBrush="#353545" BorderThickness="1" />
                                            <Border Width="16" Height="32" Background="#282C34" BorderBrush="#353545" BorderThickness="1,1,0,1" />
                                            <Border Width="16" Height="32" Background="#61AFEF" BorderBrush="#353545" BorderThickness="1,1,0,1" />
                                            <Border Width="16" Height="32" Background="#ABB2BF" CornerRadius="0,3,3,0" BorderBrush="#353545" BorderThickness="1" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="ThemeOneDarkTitle" Text="One Dark Pro" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="ThemeOneDarkDesc" Text="Ispirato al celebre tema Atom con toni blu notte e accento celeste." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckOneDark" Width="22" Height="22" CornerRadius="11" Background="#61AFEF" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Card 4: Dark Green (Verde Scuro) -->
                                <Border x:Name="CardDarkGreen"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Cursor="Hand" PointerPressed="OnSelectDarkGreen">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <Border Width="16" Height="32" Background="#101814" CornerRadius="3,0,0,3" BorderBrush="#2A4236" BorderThickness="1" />
                                            <Border Width="16" Height="32" Background="#16231D" BorderBrush="#2A4236" BorderThickness="1,1,0,1" />
                                            <Border Width="16" Height="32" Background="#10B981" BorderBrush="#2A4236" BorderThickness="1,1,0,1" />
                                            <Border Width="16" Height="32" Background="#E4EFE8" CornerRadius="0,3,3,0" BorderBrush="#2A4236" BorderThickness="1" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="ThemeDarkGreenTitle" Text="Forest Dark (Verde Scuro)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="ThemeDarkGreenDesc" Text="Atmosfera scura foresta con toni smeraldo e verde salvia." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckDarkGreen" Width="22" Height="22" CornerRadius="11" Background="#10B981" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Card 5: Light Modern -->
                                <Border x:Name="CardLightModern"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Cursor="Hand" PointerPressed="OnSelectLightModern">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <Border Width="16" Height="32" Background="#F3F3F7" CornerRadius="3,0,0,3" BorderBrush="#9E9EB0" BorderThickness="1" />
                                            <Border Width="16" Height="32" Background="#FFFFFF" BorderBrush="#9E9EB0" BorderThickness="1,1,0,1" />
                                            <Border Width="16" Height="32" Background="#0066B8" BorderBrush="#9E9EB0" BorderThickness="1,1,0,1" />
                                            <Border Width="16" Height="32" Background="#1A1A24" CornerRadius="0,3,3,0" BorderBrush="#9E9EB0" BorderThickness="1" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="ThemeLightModernTitle" Text="Light Modern" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="ThemeLightModernDesc" Text="Tema chiaro ad alto contrasto per ambienti diurni con accento cobalto." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckLightModern" Width="22" Height="22" CornerRadius="11" Background="#0066B8" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- SEZIONE 2: LINGUA (ITALIANO / INGLESE) -->
                    <ScrollViewer x:Name="LanguageSection" IsVisible="False" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="LangHeaderTitle" Text="Seleziona Lingua Interfaccia" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                <TextBlock x:Name="LangHeaderSub" Text="La lingua selezionata verrà applicata immediatamente a tutti i menu e comandi." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <!-- Card Italiano -->
                                <Border x:Name="CardLangItalian"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="16" Cursor="Hand" PointerPressed="OnSelectItalian">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="🇮🇹" FontSize="26" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="LangItalianTitle" Text="Italiano" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="LangItalianDesc" Text="Interfaccia, menu e documentazione in lingua italiana." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckLangItalian" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Card English -->
                                <Border x:Name="CardLangEnglish"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="16" Cursor="Hand" PointerPressed="OnSelectEnglish">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="🇬🇧" FontSize="26" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="LangEnglishTitle" Text="English" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="LangEnglishDesc" Text="Full English interface, menus, and inspection terminology." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckLangEnglish" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ThemeAccentBrush}" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- SEZIONE 3: COMPORTAMENTO E GRAFO -->
                    <ScrollViewer x:Name="BehaviorSection" IsVisible="False" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="BehaviorHeaderTitle" Text="Opzioni Interazione e Grafo" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                <TextBlock x:Name="BehaviorHeaderSub" Text="Personalizza il comportamento del puntatore del mouse e della vista grafo." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <!-- Card Selezione Hover -->
                                <Border x:Name="CardHoverSelection"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="16" Cursor="Hand" PointerPressed="OnToggleHoverSetting">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{DynamicResource ThemeBackgroundElevatedBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconTarget}" Width="16" Height="16" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="HoverSelectionTitleText" Text="Selezione al passaggio del mouse (Hover)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="HoverSelectionSubText" Text="Seleziona e ispeziona automaticamente i nodi quando il cursore vi passa sopra." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckHoverSelection" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Card Mostra Etichette Schede -->
                                <Border x:Name="CardShowTabLabels"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="16" Cursor="Hand" PointerPressed="OnToggleTabLabelsSetting">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{DynamicResource ThemeBackgroundElevatedBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconTable}" Width="16" Height="16" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="TabLabelsTitleText" Text="Mostra etichette schede di visualizzazione" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="TabLabelsSubText" Text="Mostra o nascondi il testo accanto alle icone nei tab centrali (Vista Grafo, Treemap, Flow...)." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckShowTabLabels" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <Rectangle Height="1" Fill="{DynamicResource ThemeBorderDefaultBrush}" Margin="0,8" />

                                <StackPanel Spacing="4" Margin="0,4,0,2">
                                    <TextBlock x:Name="StartupHeaderTitle" Text="Comportamento all'avvio dell'applicazione" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                    <TextBlock x:Name="StartupHeaderSub" Text="Scegli l'azione da eseguire automaticamente all'apertura del software." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                                </StackPanel>

                                <!-- Opzione 1: Solo se in cache (Default) -->
                                <Border x:Name="CardStartupOnlyIfCached"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Cursor="Hand" PointerPressed="OnSelectStartupOnlyIfCached">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{DynamicResource ThemeBackgroundElevatedBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconZap}" Width="16" Height="16" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="StartupOnlyIfCachedTitle" Text="Solo se presente in cache (Consigliato)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="StartupOnlyIfCachedDesc" Text="Ripristina istantaneamente l'ultimo progetto se presente in cache. Se assente, mostra la schermata iniziale senza bloccare l'interfaccia." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckStartupOnlyIfCached" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Opzione 2: Analizza sempre automaticamente -->
                                <Border x:Name="CardStartupAlways"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Cursor="Hand" PointerPressed="OnSelectStartupAlways">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{DynamicResource ThemeBackgroundElevatedBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconRefresh}" Width="16" Height="16" Foreground="#4AE8D0" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="StartupAlwaysTitle" Text="Analizza sempre automaticamente" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="StartupAlwaysDesc" Text="Scansiona e analizza sempre l'ultimo progetto aperto da sorgenti, anche in assenza di cache." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckStartupAlways" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ThemeAccentBrush}" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Opzione 3: Mostra sempre schermata iniziale (Workspace vuoto) -->
                                <Border x:Name="CardStartupEmpty"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Cursor="Hand" PointerPressed="OnSelectStartupEmpty">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{DynamicResource ThemeBackgroundElevatedBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconHome}" Width="16" Height="16" Foreground="#A78BFA" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="StartupEmptyTitle" Text="Mostra sempre schermata iniziale" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="StartupEmptyDesc" Text="Avvia sempre l'applicazione su un'area di lavoro vuota pronta per una nuova selezione." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckStartupEmpty" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ThemeAccentBrush}" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- SEZIONE 4: SCHEDE ANALITICHE (VISIBILITÀ TAB) -->
                    <ScrollViewer x:Name="AnalyticsTabsSection" IsVisible="False" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="AnalyticsTabsHeaderTitle" Text="Visibilità Schede di Analisi" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                <TextBlock x:Name="AnalyticsTabsHeaderSub" Text="Scegli quali schede e viste analitiche mostrare nella barra centrale." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Barra Azioni Rapide (Seleziona Tutte / Deseleziona Tutte) -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SelectAllTabsButton"
                                        Padding="10,5"
                                        FontSize="11"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                        Click="OnSelectAllTabsClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconCheck}" Width="10" Height="10" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="SelectAllTabsButtonText" Text="Seleziona Tutte" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DeselectAllTabsButton"
                                        Padding="10,5"
                                        FontSize="11"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                        Click="OnDeselectAllTabsClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconWindowClose}" Width="10" Height="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DeselectAllTabsButtonText" Text="Deseleziona Tutte" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Griglia/Lista delle Schede Analitiche e Viste -->
                            <StackPanel Spacing="8">
                                <!-- Card Vista Grafo -->
                                <Border x:Name="CardTabGraph"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Cursor="Hand" PointerPressed="OnToggleTabGraph">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{DynamicResource ThemeBackgroundElevatedBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconGraph}" Width="16" Height="16" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="TabGraphTitle" Text="Vista Grafo" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="TabGraphDesc" Text="Canvas interattivo con visualizzazione a grafo nodi-relazioni dei simboli e moduli." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckTabGraph" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Card DSM -->
                                <Border x:Name="CardTabDsm"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Cursor="Hand" PointerPressed="OnToggleTabDsm">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{DynamicResource ThemeBackgroundElevatedBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconMatrix}" Width="16" Height="16" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="TabDsmTitle" Text="Matrice DSM" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="TabDsmDesc" Text="Matrice di dipendenza strutturale (DSM) e rilevamento cicli." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckTabDsm" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Card Treemap -->
                                <Border x:Name="CardTabTreemap"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Cursor="Hand" PointerPressed="OnToggleTabTreemap">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{DynamicResource ThemeBackgroundElevatedBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconTreemap}" Width="16" Height="16" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="TabTreemapTitle" Text="Treemap Metriche" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="TabTreemapDesc" Text="Mappa gerarchica proporzionale per linee di codice e complessità." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckTabTreemap" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Card Hotspot -->
                                <Border x:Name="CardTabHotspot"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Cursor="Hand" PointerPressed="OnToggleTabHotspot">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{DynamicResource ThemeBackgroundElevatedBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconHotspot}" Width="16" Height="16" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="TabHotspotTitle" Text="Hotspot di Rischio" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="TabHotspotDesc" Text="Matrice dei punti caldi a rischio (complessità vs churn)." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckTabHotspot" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Card Screen Flow -->
                                <Border x:Name="CardTabScreenFlow"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Cursor="Hand" PointerPressed="OnToggleTabScreenFlow">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{DynamicResource ThemeBackgroundElevatedBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconScreenFlow}" Width="16" Height="16" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="TabScreenFlowTitle" Text="Flusso Schermate" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="TabScreenFlowDesc" Text="Mappa di navigazione visiva tra form e controlli UI." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckTabScreenFlow" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Card Control Flow (CFG) -->
                                <Border x:Name="CardTabControlFlow"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Cursor="Hand" PointerPressed="OnToggleTabControlFlow">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{DynamicResource ThemeBackgroundElevatedBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconControlFlow}" Width="16" Height="16" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="TabControlFlowTitle" Text="Control Flow (CFG)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="TabControlFlowDesc" Text="Grafo a blocchi di flusso di controllo (CFG) delle routine." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckTabControlFlow" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Card Martin Metrics -->
                                <Border x:Name="CardTabMartin"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Cursor="Hand" PointerPressed="OnToggleTabMartin">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{DynamicResource ThemeBackgroundElevatedBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconMartin}" Width="16" Height="16" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="TabMartinTitle" Text="Metriche Martin" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="TabMartinDesc" Text="Grafico Sequence Principale: Astrattezza vs Instabilità." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckTabMartin" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Card Dead Code -->
                                <Border x:Name="CardTabDeadCode"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Cursor="Hand" PointerPressed="OnToggleTabDeadCode">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{DynamicResource ThemeBackgroundElevatedBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconDeadCode}" Width="16" Height="16" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="TabDeadCodeTitle" Text="Dead Code &amp; Orfani" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="TabDeadCodeDesc" Text="Rilevamento codice non utilizzato, funzioni orfane e isolamento." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckTabDeadCode" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Card Stato Condiviso -->
                                <Border x:Name="CardTabSharedState"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Cursor="Hand" PointerPressed="OnToggleTabSharedState">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{DynamicResource ThemeBackgroundElevatedBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconSharedState}" Width="16" Height="16" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="TabSharedStateTitle" Text="Stato Condiviso" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="TabSharedStateDesc" Text="Matrice delle variabili globali condivise e relative mutazioni." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckTabSharedState" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Card Temporal Coupling -->
                                <Border x:Name="CardTabTemporalCoupling"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Cursor="Hand" PointerPressed="OnToggleTabTemporalCoupling">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{DynamicResource ThemeBackgroundElevatedBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconTemporalCoupling}" Width="16" Height="16" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="TabTemporalCouplingTitle" Text="Temporal Coupling" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="TabTemporalCouplingDesc" Text="Accoppiamento temporale e co-modifiche storiche da Git." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckTabTemporalCoupling" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Card Flussi Architetturali -->
                                <Border x:Name="CardTabArchitecturalFlow"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Cursor="Hand" PointerPressed="OnToggleTabArchitecturalFlow">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{DynamicResource ThemeBackgroundElevatedBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconFlow}" Width="16" Height="16" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="TabArchitecturalFlowTitle" Text="Flussi Architetturali" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="TabArchitecturalFlowDesc" Text="Flussi e chiamate a strati con diagramma Chord interattivo." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckTabArchitecturalFlow" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Card CodeCity -->
                                <Border x:Name="CardTabCodeCity"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Cursor="Hand" PointerPressed="OnToggleTabCodeCity">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{DynamicResource ThemeBackgroundElevatedBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCity}" Width="16" Height="16" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="TabCodeCityTitle" Text="CodeCity 3D" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="TabCodeCityDesc" Text="Mappa urbana tridimensionale polimetrica del codebase." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckTabCodeCity" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Card Blast Radius Grid -->
                                <Border x:Name="CardTabBlastRadiusGrid"
                                        Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Cursor="Hand" PointerPressed="OnToggleTabBlastRadiusGrid">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{DynamicResource ThemeBackgroundElevatedBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconTable}" Width="16" Height="16" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="TabBlastRadiusGridTitle" Text="Griglia Blast Radius" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <TextBlock x:Name="TabBlastRadiusGridDesc" Text="Tabella riassuntiva di audit impatto e matrice di rischio." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="CheckTabBlastRadiusGrid" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- SEZIONE 5: SCORCIATOIE DA TASTIERA -->
                    <Grid x:Name="ShortcutsSection" RowDefinitions="Auto,Auto,*" IsVisible="False">
                        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
                            <TextBlock x:Name="ShortcutsHeaderTitle" Text="Catalogo Scorciatoie da Tastiera" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                            <TextBlock x:Name="ShortcutsHeaderSub" Text="Tutte le combinazioni di tasti per navigare rapidamente nel codice e nel grafo." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                        </StackPanel>

                        <!-- Filtro di Ricerca Scorciatoie -->
                        <TextBox Grid.Row="1" x:Name="ShortcutSearchBox"
                                 Watermark="Cerca scorciatoia..."
                                 FontSize="11"
                                 Margin="0,0,0,10"
                                 TextChanged="OnShortcutSearchTextChanged">
                            <TextBox.InnerLeftContent>
                                <PathIcon Data="{StaticResource IconSearch}" Width="12" Height="12" Margin="8,0,4,0" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                            </TextBox.InnerLeftContent>
                        </TextBox>

                        <!-- Lista Scorciatoie -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ShortcutsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:ShortcutItem">
                                        <Border Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
                                                BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="150,Auto,*">
                                                <!-- Keycaps Stilizzati -->
                                                <Border Grid.Column="0"
                                                        Background="{DynamicResource ThemeBackgroundElevatedBrush}"
                                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8,3"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding KeyChord}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource ThemeAccentBrush}"
                                                               FontFamily="Consolas, monospace" />
                                                </Border>

                                                <!-- Categoria -->
                                                <Border Grid.Column="1"
                                                        Background="{DynamicResource ThemeBackgroundElevatedBrush}"
                                                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="5,1"
                                                        Margin="8,0,12,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentBrush}" />
                                                </Border>

                                                <!-- Nome e Spiegazione -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ActionName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                </Panel>
            </Border>
        </Grid>
    </Grid>
</Window>
