<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Macondo.Parser.Spike</RootNamespace>
    <AssemblyName>Macondo.Parser.Spike</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VB6Analyzer.Parser\VB6Analyzer.Parser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- i fixture .cls vengono copiati accanto all'eseguibile così Program.cs li trova a runtime -->
    <None Include="Fixtures\*.cls">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
