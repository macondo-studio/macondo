<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Macondo.Parser</RootNamespace>
    <AssemblyName>Macondo.Parser</AssemblyName>

    <!--
      Antlr4BuildTasks invoca lo strumento antlr4 (Java) durante la build per rigenerare
      lexer/parser C# dai file .g4. Serve una JRE/JDK installata in locale (solo in fase
      di build, MAI a runtime nell'app finale: il risultato è codice C# puro).
      Se non hai Java: https://adoptium.net (Temurin, gratuito).

      IMPORTANTE: il download automatico del jar ANTLR può fallire dietro proxy/antivirus
      aziendali (errore "Cannot find Antlr4 jar file"). AntlrProbePath sotto punta a un jar
      scaricato manualmente in external/ per bypassare quel download. Vedi README per
      istruzioni su dove scaricarlo. Il nome del file DEVE essere antlr4-4.13.2-complete.jar
      e la versione deve combaciare con Antlr4.Runtime.Standard sotto.
    -->
    <AntlrProbePath>file:///$(MSBuildProjectDirectory)/external/</AntlrProbePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4BuildTasks" Version="12.*" />
    <!-- Versione fissata (non floating) per far combaciare esattamente il jar locale in external/.
         4.13.1 è l'ultima disponibile su NuGet per Antlr4.Runtime.Standard (4.13.2 NON esiste su NuGet). -->
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Package = namespace C# generato. Stesso Package per lexer e parser: il parser
      referenzia i token del lexer (tokenVocab = VisualBasic6Lexer nel .g4) e deve
      trovarli nello stesso namespace generato.
    -->
    <Antlr4 Include="Grammar\VisualBasic6Lexer.g4">
      <Package>Macondo.Parser.Grammar</Package>
      <Visitor>true</Visitor>
      <Listener>false</Listener>
    </Antlr4>
    <Antlr4 Include="Grammar\VisualBasic6Parser.g4">
      <Package>Macondo.Parser.Grammar</Package>
      <Visitor>true</Visitor>
      <Listener>false</Listener>
    </Antlr4>
  </ItemGroup>

</Project>
