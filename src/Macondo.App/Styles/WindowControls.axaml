<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- STILI PER CONTROLLI FINESTRA, TOOLBAR, SEARCH BOX E FLOATING HUD         -->
    <!-- ========================================================================= -->

    <!-- ========================================== -->
    <!-- 1. Pulsanti Controlli Finestra (Caption)   -->
    <!-- ========================================== -->
    <Style Selector="Button.caption-btn">
        <Setter Property="Width" Value="46" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
    </Style>

    <Style Selector="Button.caption-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.caption-close:pointerover">
        <Setter Property="Background" Value="#E81123" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- ========================================== -->
    <!-- 2. Pulsanti Toggle Pannelli Laterali       -->
    <!-- ========================================== -->
    <Style Selector="Button.toggle-panel-btn">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.toggle-panel-btn PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
    </Style>

    <Style Selector="Button.toggle-panel-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
    </Style>

    <Style Selector="Button.toggle-panel-btn:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.toggle-panel-btn.active">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundSurfaceBrush}" />
    </Style>

    <Style Selector="Button.toggle-panel-btn.active PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <!-- ========================================== -->
    <!-- 3. Casella di Ricerca Dedicata Centrata    -->
    <!-- ========================================== -->
    <Style Selector="TextBox#SearchBox">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="TextBox#SearchBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
    </Style>

    <Style Selector="TextBox#SearchBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundElevatedBrush}" />
    </Style>

    <!-- ========================================== -->
    <!-- 4. Controlli Floating HUD del Grafo        -->
    <!-- ========================================== -->
    <Style Selector="Border#FloatingHudBorder Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
    </Style>

    <Style Selector="Border#FloatingHudBorder Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <Style Selector="Border#FloatingHudBorder Button PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
    </Style>

    <Style Selector="Border#FloatingHudBorder Button:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <Style Selector="Border#FloatingHudBorder ComboBox">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Border#FloatingHudBorder ComboBox:pointerover">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderDefaultBrush}" />
    </Style>

</Styles>
