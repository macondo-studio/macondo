<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Macondo.App.Views.LayoutConfirmModalView">

    <Grid Background="#75101018">
        <Border Background="{DynamicResource ThemeBackgroundElevatedBrush}"
                BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="28,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="500"
                MinWidth="400"
                MaxWidth="600"
                BoxShadow="0 12 36 0 #80000000">
            <StackPanel Spacing="18">
                <!-- Header con Icona Warning e Titoli -->
                <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8" Background="#F59E0B" Opacity="0.15" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <PathIcon Grid.Column="0" Data="{StaticResource IconWarning}" Width="22" Height="22" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="LayoutConfirmModalTitle" Text="Modifica Disposizione Grafo" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        <TextBlock x:Name="LayoutConfirmModalSubtitle" Text="Sei sicuro di voler cambiare il layout del grafo? La posizione personalizzata dei nodi spostati verrà reimpostata secondo il nuovo algoritmo."
                                   FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!-- Barra Pulsanti Azione -->
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Button x:Name="LayoutConfirmCancelButton" Grid.Column="1" Content="Annulla" Click="OnCancelClicked"
                            Padding="16,6" Margin="0,0,10,0" Background="Transparent" Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                            BorderBrush="{DynamicResource ThemeBorderDefaultBrush}" BorderThickness="1" CornerRadius="4" FontSize="12" Cursor="Hand" />
                    <Button x:Name="LayoutConfirmApplyButton" Grid.Column="2" Content="Cambia Layout" Click="OnApplyClicked"
                            Padding="18,6" Background="{DynamicResource ThemeAccentBrush}" Foreground="White"
                            BorderThickness="0" CornerRadius="4" FontSize="12" FontWeight="SemiBold" Cursor="Hand" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
