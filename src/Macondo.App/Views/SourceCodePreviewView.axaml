<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Macondo.App.Models"
             x:Class="Macondo.App.Views.SourceCodePreviewView">

    <Border Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
            BorderThickness="0" Padding="12">
        <Grid RowDefinitions="Auto,*">
            <!-- Intestazione Barra Superiore: Titolo, Badge LOC, Linguaggio e Pulsanti Rapidi -->
            <Grid Grid.Row="0" Margin="4,4,4,8" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconFile}" Width="13" Height="13" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderTitleText" Text="Codice Sorgente" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Badge Linguaggio -->
                <Border Grid.Column="1" x:Name="LanguageBadge"
                        CornerRadius="3" Padding="6,2" Margin="4,0"
                        VerticalAlignment="Center" IsVisible="False">
                    <TextBlock x:Name="LanguageBadgeText" FontWeight="Bold" FontSize="10" />
                </Border>

                <!-- Badge Conteggio Righe / LOC -->
                <Border Grid.Column="2" x:Name="LocBadge"
                        Background="{DynamicResource ThemeBackgroundSecondaryBrush}"
                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="4,0"
                        VerticalAlignment="Center" IsVisible="False">
                    <TextBlock x:Name="LocBadgeText" Text="0 righe" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                </Border>

                <!-- Pulsante Copia Codice -->
                <Button Grid.Column="3" x:Name="CopyCodeButton"
                        Background="Transparent" BorderThickness="0" Padding="4,2" Margin="2,0"
                        ToolTip.Tip="Copia codice sorgente negli appunti"
                        Click="OnCopyClicked">
                    <PathIcon Data="{StaticResource IconCopy}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                </Button>

                <!-- Pulsante Apri File Originale -->
                <Button Grid.Column="4" x:Name="OpenFileButton"
                        Background="Transparent" BorderThickness="0" Padding="4,2" Margin="2,0"
                        ToolTip.Tip="Apri file originale"
                        Click="OnOpenFileClicked">
                    <PathIcon Data="{StaticResource IconExport}" Width="13" Height="13" Foreground="{DynamicResource ThemeAccentBrush}" />
                </Button>

                <!-- Pulsante Mostra nella Cartella -->
                <Button Grid.Column="5" x:Name="OpenFolderButton"
                        Background="Transparent" BorderThickness="0" Padding="4,2" Margin="2,0"
                        ToolTip.Tip="Mostra nella cartella"
                        Click="OnOpenFolderClicked">
                    <PathIcon Data="{StaticResource IconFolder}" Width="13" Height="13" Foreground="#D4A72C" />
                </Button>
            </Grid>

            <!-- Stato Vuoto (Nessun Simbolo Selezionato) -->
            <StackPanel Grid.Row="1" x:Name="EmptyPanel" Spacing="8" Margin="4,16" IsVisible="False">
                <TextBlock x:Name="EmptyTitleText" Text="Nessun simbolo selezionato." Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontWeight="Medium" />
                <TextBlock x:Name="EmptyHintText" Text="Seleziona un nodo nel grafo o nel Project Explorer per visualizzarne l'anteprima del codice sorgente." Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Riquadro Viewer Codice Sorgente -->
            <Grid Grid.Row="1" x:Name="ContentPanel" RowDefinitions="Auto,*,Auto" IsVisible="False">
                <!-- Sottotitolo Percorso File e Coordinate -->
                <TextBlock Grid.Row="0" x:Name="FilePathText"
                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                           FontSize="11" TextWrapping="Wrap" Margin="4,0,4,8" />

                <!-- Area Codice Monospace con Numeri di Riga -->
                <Border Grid.Row="1"
                        Background="{DynamicResource ThemeBackgroundPrimaryBrush}"
                        BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="8,6">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid ColumnDefinitions="Auto,Auto,*">
                            <!-- Colonna Numeri di Riga -->
                            <TextBlock Grid.Column="0" x:Name="LineNumbersText"
                                       FontFamily="Consolas, Cascadia Code, Courier New, monospace"
                                       FontSize="11" LineHeight="18"
                                       Foreground="{DynamicResource ThemeTextMutedBrush}"
                                       TextAlignment="Right" Margin="0,0,8,0" />

                            <!-- Separatore Verticale -->
                            <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource ThemeBorderDefaultBrush}" Margin="0,0,8,0" />

                            <!-- Colonna Codice Sorgente Selezionabile -->
                            <SelectableTextBlock Grid.Column="2" x:Name="CodeText"
                                                 FontFamily="Consolas, Cascadia Code, Courier New, monospace"
                                                 FontSize="11" LineHeight="18"
                                                 Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                 TextWrapping="NoWrap" />
                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- Avviso Troncamento Righe per file molto estesi -->
                <TextBlock Grid.Row="2" x:Name="TruncatedNoticeText"
                           Text="" IsVisible="False" Margin="4,6,4,0"
                           FontSize="10" Foreground="{DynamicResource ThemeTextMutedBrush}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
