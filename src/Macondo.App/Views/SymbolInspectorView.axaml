<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Macondo.App.Models"
             x:Class="Macondo.App.Views.SymbolInspectorView">

    <Border Background="{DynamicResource ThemeBackgroundSurfaceBrush}"
            BorderThickness="0" Padding="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <!-- Intestazione Inspector -->
                <Grid Margin="4,4,4,8">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconInspect}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="InspectorTitleText" Text="Symbol Inspector &amp; Blast Radius" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>                                
                </Grid>

                <!-- Messaggio Nodo Non Selezionato -->
                <StackPanel x:Name="InspectorEmptyPanel" Spacing="6" Margin="4,8" IsVisible="False">
                    <TextBlock x:Name="InspectorEmptyTitle" Text="Nessun simbolo selezionato." Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontWeight="Medium" />
                    <TextBlock x:Name="InspectorEmptyHint1" Text="• Clicca su un nodo per visualizzare dettagli semantici, tipi, parametri e chiamate." Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock x:Name="InspectorEmptyHint2" Text="• Clicca su 'Blast Radius' per calcolare il raggio di impatto e il rischio di regressione." Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock x:Name="InspectorEmptyHint3" Text="• Doppio clic su una Classe, Form o Modulo per espandere/comprimere i membri." Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Dettagli Simbolo Selezionato -->
                <StackPanel x:Name="InspectorDetailsPanel" Spacing="8" IsVisible="False">
                    <!-- Nome -->
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="InspectorSecSymbol" Text="SIMBOLO" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" />
                        <TextBlock x:Name="InspectorName" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource ThemeTextPrimaryBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="InspectorQualifiedName" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Kind, Visibilità & Linguaggio -->
                    <Grid ColumnDefinitions="*,*,*" Margin="0,4">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Name="InspectorSecKind" Text="CATEGORIA" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock x:Name="InspectorKind" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="InspectorSecVisibility" Text="VISIBILITÀ" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock x:Name="InspectorAccessibility" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock x:Name="InspectorSecLanguage" Text="LINGUAGGIO" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" />
                            <Border x:Name="InspectorLanguageBadge"
                                    CornerRadius="3"
                                    Padding="6,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="InspectorLanguage" FontWeight="Bold" FontSize="10" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Tipo Dichiarato & Risolto -->
                    <StackPanel x:Name="InspectorTypeSection" Spacing="2" Margin="0,2">
                        <TextBlock x:Name="InspectorSecType" Text="TIPO" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" />
                        <TextBlock x:Name="InspectorType" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="12" />
                    </StackPanel>

                    <!-- Parametri Routine -->
                    <StackPanel x:Name="InspectorParamsSection" Spacing="3" Margin="0,2">
                        <TextBlock x:Name="InspectorSecParams" Text="PARAMETRI FORMALI" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" />
                        <TextBlock x:Name="InspectorParams" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" FontFamily="Consolas, monospace" />
                    </StackPanel>

                    <!-- File e Righe -->
                    <StackPanel x:Name="InspectorFileSection" Spacing="2" Margin="0,2">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" x:Name="InspectorSecFile" Text="FILE &amp; RIGHE" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="InspectorOpenFileButton"
                                    Background="Transparent" BorderThickness="0" Padding="3,1" Margin="2,0"
                                    ToolTip.Tip="Apri file originale"
                                    Click="OnOpenFileClicked">
                                <PathIcon Data="{StaticResource IconExport}" Width="11" Height="11" Foreground="{DynamicResource ThemeAccentBrush}" />
                            </Button>
                            <Button Grid.Column="2" x:Name="InspectorOpenFolderButton"
                                    Background="Transparent" BorderThickness="0" Padding="3,1" Margin="2,0"
                                    ToolTip.Tip="Mostra nella cartella"
                                    Click="OnOpenFolderClicked">
                                <PathIcon Data="{StaticResource IconFolder}" Width="11" Height="11" Foreground="#D4A72C" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="InspectorFile" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11" />
                    </StackPanel>

                    <Rectangle Height="1" Fill="{DynamicResource ThemeBorderDefaultBrush}" Margin="0,6" />

                    <!-- Sezione AI Context / LLM Slice -->
                    <Border x:Name="AiContextCardBorder"
                            Background="{DynamicResource ThemeBackgroundElevatedBrush}"
                            BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock x:Name="InspectorSecAiContext" Text="AI CONTEXT / LLM SLICE" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="InspectorAiContextDesc" Text="Estrae il subgrafo di questo simbolo ottimizzato per prompt AI." Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,*" Margin="0,4">
                                <Button Grid.Column="0" x:Name="CopyLlmSliceButton"
                                        Margin="0,0,4,0" Padding="8,5"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        ToolTip.Tip="Copia negli appunti il context slice per Antigravity/ChatGPT"
                                        Click="OnCopySliceClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconCopy}" Width="11" Height="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="CopyLlmSliceButtonText" Text="Copia Slice" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" x:Name="SaveLlmSliceButton"
                                        Margin="4,0,0,0" Padding="8,5"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        ToolTip.Tip="Salva il subgrafo del simbolo come file .md"
                                        Click="OnSaveSliceClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconMarkdown}" Width="11" Height="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="SaveLlmSliceButtonText" Text="Salva (.md)" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Rectangle Height="1" Fill="{DynamicResource ThemeBorderDefaultBrush}" Margin="0,6" />

                    <!-- Sezione Impact Analysis & Blast Radius -->
                    <Border x:Name="BlastRadiusCardBorder"
                            Background="{DynamicResource ThemeBackgroundElevatedBrush}"
                            BorderBrush="{DynamicResource ThemeBorderDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock x:Name="InspectorSecBlast" Text="BLAST RADIUS (IMPACT)" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border Grid.Column="1" x:Name="RiskBadge" CornerRadius="4" Padding="6,2" Background="#2E7D32">
                                    <TextBlock x:Name="RiskLevelText" Text="RISK: LOW" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </Grid>

                            <!-- Metriche di Impatto -->
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4">
                                <TextBlock Grid.Row="0" Grid.Column="0" x:Name="InspectorLabelDirectCallers" Text="Chiamanti Diretti:" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BlastDirectCallersCount" Text="0" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />

                                <TextBlock Grid.Row="1" Grid.Column="0" x:Name="InspectorLabelIndirectCallers" Text="Chiamanti Indiretti:" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BlastIndirectCallersCount" Text="0" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />

                                <TextBlock Grid.Row="2" Grid.Column="0" x:Name="InspectorLabelMaxDepth" Text="Profondità Max (Depth):" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BlastMaxDepth" Text="0" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Form UI Impattate -->
                            <StackPanel x:Name="BlastFormsSection" Spacing="2" Margin="0,2">
                                <TextBlock x:Name="InspectorSecForms" Text="FORM UI IMPATTATE" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="BlastFormsList" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" />
                            </StackPanel>

                            <!-- Classi & Moduli Impattati -->
                            <StackPanel x:Name="BlastClassesSection" Spacing="2" Margin="0,2">
                                <TextBlock x:Name="InspectorSecClasses" Text="CLASSI &amp; MODULI TOCCATI" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="BlastClassesList" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" />
                            </StackPanel>

                            <!-- Percorsi di Esecuzione a Rischio -->
                            <StackPanel x:Name="BlastPathsSection" Spacing="2" Margin="0,2">
                                <TextBlock x:Name="InspectorSecPaths" Text="PERCORSI DI ESECUZIONE (CALL CHAINS)" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="BlastPathsList" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="10" FontFamily="Consolas, monospace" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Rectangle Height="1" Fill="{DynamicResource ThemeBorderDefaultBrush}" Margin="0,6" />

                    <!-- Chiamanti Diretti (Callers) -->
                    <StackPanel Spacing="3">
                        <TextBlock x:Name="InspectorSecCallers" Text="CHIAMANTI DIRETTI (WHO CALLS ME?)" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" />
                        <TextBlock x:Name="InspectorCallers" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" />
                    </StackPanel>

                    <!-- Chiamati Diretti (Callees) -->
                    <StackPanel Spacing="3" Margin="0,4">
                        <TextBlock x:Name="InspectorSecCallees" Text="CHIAMATE EFFETTUATE (WHAT DO I CALL?)" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" />
                        <TextBlock x:Name="InspectorCallees" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" />
                    </StackPanel>

                    <!-- Istanziazioni -->
                    <StackPanel x:Name="InspectorInstantiatesSection" Spacing="3" Margin="0,4">
                        <TextBlock x:Name="InspectorSecInstantiates" Text="CLASSI ISTANZIATE (NEW)" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10" FontWeight="Bold" />
                        <TextBlock x:Name="InspectorInstantiates" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
